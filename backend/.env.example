# =============================================================================
# Codemed Hub — Variaveis de Ambiente
# Copie este arquivo para backend/.env e preencha os valores
# =============================================================================

# ── Banco de Dados ────────────────────────────────────────────────────────────
# PostgreSQL (local com Docker: docker-compose up -d)
DATABASE_URL=postgresql://codemed:codemed123@localhost:5432/codemed?schema=public

# Redis (opcional, para cache e filas)
REDIS_URL=redis://localhost:6379

# ── Seguranca ─────────────────────────────────────────────────────────────────
# Chaves JWT (gere chaves unicas para producao!)
JWT_SECRET=coloque_um_secret_forte_aqui
JWT_REFRESH_SECRET=coloque_outro_secret_forte_aqui

# ── Aplicacao ─────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
API_URL=http://localhost:3010
PORT=3010
NODE_ENV=development
TIMEZONE=America/Fortaleza

# ── WhatsApp ──────────────────────────────────────────────────────────────────
WHATSAPP_SESSION_PATH=./whatsapp-session
WHATSAPP_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ── IA (opcional) ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Email (opcional) ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Alertas ───────────────────────────────────────────────────────────────────
ALERT_WHATSAPP_NUMBERS=
ALERT_DAY=1
ALERT_HOUR=8
