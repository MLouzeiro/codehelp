# =============================================================================
# Codemed Hub — Variaveis de Ambiente
# Copie este arquivo para backend/.env e preencha os valores
# =============================================================================

# ── Banco de Dados ────────────────────────────────────────────────────────────
# PostgreSQL local (Docker): postgresql://user:pass@localhost:5434/codemed_hub?schema=public
# PostgreSQL web (Neon): usar DATABASE_URL pooled + DIRECT_URL unpooled
DATABASE_URL=postgresql://user:pass@localhost:5434/codemed_hub?schema=public
DIRECT_URL=postgresql://user:pass@localhost:5434/codemed_hub?schema=public

# Redis (opcional, para cache e filas)
REDIS_URL=redis://localhost:6379

# ── Seguranca ─────────────────────────────────────────────────────────────────
# Chaves JWT (gere chaves unicas para producao!)
JWT_SECRET=coloque_um_secret_forte_aqui_min_64_chars
JWT_REFRESH_SECRET=coloque_outro_secret_forte_aqui_min_64_chars

# Chave para criptografar secrets de integracoes externas (AES-256)
INTEGRATION_ENCRYPTION_KEY=

# API keys para a API publica de integracao (separadas por virgula)
INTEGRATION_API_KEYS=

# ── Aplicacao ─────────────────────────────────────────────────────────────────
# URL do frontend (usada em links enviados ao cliente, ex: https://app.seudominio.com)
APP_URL=http://localhost:4000
API_URL=http://localhost:3010
PORT=3010
NODE_ENV=development
TIMEZONE=America/Fortaleza

# ── WhatsApp ──────────────────────────────────────────────────────────────────
WHATSAPP_SESSION_PATH=./whatsapp-session
WHATSAPP_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# WhatsApp Cloud API (Meta Official)
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_API_VERSION=v19.0
WHATSAPP_CLOUD_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=

# Evolution API (self-hosted Docker)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=codehelp
EVOLUTION_WEBHOOK_SECRET=

# ── IA (opcional) ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Email (opcional) ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Alertas ───────────────────────────────────────────────────────────────────
ALERT_WHATSAPP_NUMBERS=
ALERT_DAY=1
ALERT_HOUR=8

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origens permitidas (separadas por virgula). Em producao, usar dominio exato.
CORS_ORIGINS=http://localhost:5173,http://localhost:4000,http://localhost:3000

# ── Integracao Externa (API publica) ──────────────────────────────────────────
BACKEND_URL=http://localhost:3010
