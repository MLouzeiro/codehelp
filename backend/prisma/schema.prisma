generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Organizacao/Tenant — entidade raiz do multi-tenancy.
/// Cada organizacao e isolada: seus usuarios, clientes, tickets, configuracoes, etc.
model Organization {
  id                 String                @id @default(uuid())
  nome               String
  slug               String                @unique
  cnpjCpf            String?
  email              String?
  telefone           String?
  website            String?
  logo               String?
  ativo              Boolean               @default(true)
  plano              String                @default("free")
  maxUsuarios        Int                   @default(5)
  maxClients         Int                   @default(100)
  config             String                @default("{}")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @default(now())
  alertRecipients    AlertRecipient[]
  aprovacoes         Aprovacao[]
  assuntos           Assunto[]
  auditAlerts        AuditAlert[]
  auditLogs          AuditLog[]
  automationRules    AutomationRule[]
  categorias         Categoria[]
  channels           Channel[]
  checklistTemplates ChecklistTemplate[]
  clients            Client[]
  departamentos      Departamento[]
  enquetes           Enquete[]
  integrations       ExternalIntegration[]
  feriados           Feriado[]
  filas              Fila[]
  helpdeskConfigs    HelpdeskConfig[]
  helpdeskRules      HelpdeskRule[]
  kbArticles         KBArticle[]
  kanbanBoards       KanbanBoard[]
  niveisSuporte      NivelSuporte[]
  notificacoes       Notificacao[]
  osLayouts          OSLayout[]
  robots             Robot[]
  slaConfigs         SLAConfig[]
  serviceOrders      ServiceOrder[]
  tasks              Task[]
  teams              Team[]
  tickets            Ticket[]
  users              User[]
   whatsappConns      WhatsAppConnection[]
   clientAlerts       ClientAlert[]
    analystOccurrences AnalystOccurrence[]
    decisionAudits     DecisionAudit[]


   @@index([ativo])
   @@index([slug])
}

model User {
  id                          String                    @id @default(uuid())
  name                        String
  email                       String                    @unique
  password                    String
  role                        String                    @default("tecnico")
  isMaster                    Boolean                   @default(false)
  phone                       String?
  avatar                      String?
  active                      Boolean                   @default(true)
  online                      Boolean                   @default(false)
  lastSeenAt                  DateTime?
  sessionToken                String?                   @unique
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @default(now())
  signature                   String?
  organizationId              String?
  aiAgentAudits               AIAgentAudit[]
  aiCorrections               AICorrection[]
  aprovacoesDecididas         Aprovacao[]               @relation("AprovacaoAprovador")
  aprovacoesSolicitadas       Aprovacao[]               @relation("AprovacaoSolicitante")
  auditLogs                   AuditLog[]
  auditoriasAgente            AuditoriaProfissional[]   @relation("AuditoriaAgente")
  auditoriasRevisadas         AuditoriaProfissional[]   @relation("AuditoriaRevisor")
  billingHistory              BillingHistory[]
  checklistTemplates          ChecklistTemplate[]
  clientTechnician            Client[]                  @relation("ClientTechnician")
  contacts                    Contact[]
  contatosIgnoradosCriados    ContatoIgnorado[]         @relation("ContatoIgnoradoCriadoPor")
  contatosIgnoradosReativados ContatoIgnorado[]         @relation("ContatoIgnoradoReativadoPor")
  kbArticlesAutor             KBArticle[]               @relation("KBArticleAutor")
  kbVersionsAutor             KBArticleVersion[]        @relation("KBArticleVersionAutor")
  kanbanActivities            KanbanActivity[]          @relation("KanbanActivityUsuario")
  kanbanAttachments           KanbanAttachment[]        @relation("KanbanAttachmentUsuario")
  kanbanBoardsCreated         KanbanBoard[]             @relation("KanbanBoardCriador")
  stageTimes                  KanbanStageTime[]
  kanbanSubtasks              KanbanSubtask[]           @relation("KanbanSubtaskResponsavel")
  kanbanTasksArquivadas       KanbanTask[]              @relation("KanbanTaskArquivador")
  kanbanTasks                 KanbanTask[]              @relation("KanbanTaskResponsavel")
  kanbanTemplates             KanbanTemplate[]          @relation("KanbanTemplateCriador")
  messages                    Message[]
  notificacoes                Notificacao[]
  opportunities               Opportunity[]
  orderCreator                ServiceOrder[]            @relation("OrderCreator")
  orderTechnician             ServiceOrder[]            @relation("OrderTechnician")
  serviceOrderStatusEvents    ServiceOrderStatusEvent[]
  tasks                       Task[]
  teamsLider                  Team[]                    @relation("TeamLider")
  teamMemberships             TeamMember[]
  ticketsAtendidos            Ticket[]                  @relation("TicketAssignee")
  ticketsPrimeiroAgente       Ticket[]                  @relation("TicketPrimeiroAgente")
  tickets                     Ticket[]
  ticketActivities            TicketActivity[]
  agentInteractions           TicketAgentInteraction[]
  ticketChecklists            TicketChecklist[]
  departmentTimes             TicketDepartmentTime[]
  ticketEvents                TicketEvent[]
  ticketPerformance           TicketPerformance[]
  ticketSlaLogs               TicketSlaLog[]
  stageMovements              TicketStageEvent[]
  timelineAnterior            TicketTimeline[]          @relation("TimelineResponsavelAnterior")
  timelineNovo                TicketTimeline[]          @relation("TimelineResponsavelNovo")
  ticketWaitTimes             TicketWaitTime[]
  timeEntries                 TimeEntry[]
  timeEntryBlocks             TimeEntryBlock[]
   organization                Organization?             @relation(fields: [organizationId], references: [id])
   departamentos               UserDepartamento[]
   clientAlertsCreated         ClientAlert[]             @relation("ClientAlertCreator")
   analystOccurrences          AnalystOccurrence[]       @relation("AnalystOccurrenceUser")
   analystOccurrencesCreated   AnalystOccurrence[]       @relation("AnalystOccurrenceCreator")
   decisionAuditsCriados       DecisionAudit[]           @relation("DecisionAuditCriadoPor")
   decisionAuditsRevisados     DecisionAudit[]           @relation("DecisionAuditRevisadoPor")
}

model Client {
  id                   String            @id @default(uuid())
  razaoSocial          String
  nomeFantasia         String?
  cnpjCpf              String?
  segmento             String            @default("laboratorio")
  responsavelTecnicoId String?
  telefone             String?
  email                String?
  cidade               String?
  estado               String?
  status               String            @default("ativo")
  origem               String            @default("manual")
  tipoContrato         String?
  valorMensalidade     Float?
  diaVencimento        Int?
  dataInicioContrato   DateTime?
  dataFimContrato      DateTime?
  whatsappContactId    String?
  ativo                Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @default(now())
  organizationId       String?
  ativos               Ativo[]
  auditLogs            AuditLog[]
  billingHistory       BillingHistory[]
  billingPendencies    BillingPendency[]
  organization         Organization?     @relation(fields: [organizationId], references: [id])
  responsavelTecnico   User?             @relation("ClientTechnician", fields: [responsavelTecnicoId], references: [id])
  billings             ClientBilling[]
  colaboradores        Colaborador[]
  contacts             Contact[]
  kanbanTasks          KanbanTask[]
  opportunities        Opportunity[]
   serviceOrders        ServiceOrder[]
   tickets              Ticket[]
   timeEntries          TimeEntry[]
   clientAlerts         ClientAlert[]
}

/// Colaborador de um cliente (pessoa que trabalha na empresa cliente)
/// Diferente de Contact: Contact registra INTERACOES (ligacoes, emails trocados);
/// Colaborador lista PESSOAS que trabalham no cliente.
model Colaborador {
  id          String   @id @default(uuid())
  clientId    String
  nome        String
  cargo       String?
  setor       String?
  email       String?
  telefone    String?
  whatsapp    String?
  principal   Boolean  @default(false)
  observacoes String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Contact {
  id             String   @id @default(uuid())
  clientId       String
  tipo           String
  descricao      String?
  data           DateTime @default(now())
  usuarioId      String
  duracaoMinutos Int?
  createdAt      DateTime @default(now())
  client         Client   @relation(fields: [clientId], references: [id])
  usuario        User     @relation(fields: [usuarioId], references: [id])

  @@index([clientId])
}

model Opportunity {
  id                     String    @id @default(uuid())
  clientId               String
  titulo                 String
  valorEstimado          Float?
  etapa                  String    @default("prospeccao")
  probabilidade          Int?      @default(50)
  dataFechamentoPrevista DateTime?
  responsavelId          String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now())
  client                 Client    @relation(fields: [clientId], references: [id])
  responsavel            User      @relation(fields: [responsavelId], references: [id])

  @@index([etapa])
  @@index([clientId])
}

model ServiceOrder {
  id                    String                    @id @default(uuid())
  numeroOs              String                    @unique
  clientId              String
  tipoServico           String
  descricaoServico      String?
  sistemasEnvolvidos    String                    @default("[]")
  equipamentos          String?
  tecnicoResponsavelId  String
  valorServico          Float?
  dataEmissao           DateTime                  @default(now())
  dataPrevistaEntrega   DateTime?
  status                String                    @default("rascunho")
  ticketId              String?
  observacoes           String?
  criadoPorId           String
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @default(now())
  dataFimImplantacao    DateTime?
  dataInicioImplantacao DateTime?
  horasDev              Float?                    @default(0)
  horasSuporte          Float?                    @default(0)
  implantacaoConcluida  Boolean                   @default(false)
  precoImplantacao      Float?                    @default(0)
  tipoImplantacao       String?
  dataConclusao         DateTime?
  telefoneManual        String?
  layoutId              String?
  organizationId        String?
  attachments           Attachment[]
  kanbanTasks           KanbanTask[]
  client                Client                    @relation(fields: [clientId], references: [id])
  criadoPor             User                      @relation("OrderCreator", fields: [criadoPorId], references: [id])
  layout                OSLayout?                 @relation(fields: [layoutId], references: [id])
  organization          Organization?             @relation(fields: [organizationId], references: [id])
  tecnicoResponsavel    User                      @relation("OrderTechnician", fields: [tecnicoResponsavelId], references: [id])
  ticket                Ticket?                   @relation("OrderTicket", fields: [ticketId], references: [id])
  items                 ServiceOrderItem[]
  statusEvents          ServiceOrderStatusEvent[]
  signature             Signature?
  timeEntries           TimeEntry[]

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@index([tipoImplantacao])
  @@index([implantacaoConcluida])
}

/// Timeline de status da Ordem de Servico (tempo por status, auditoria).
model ServiceOrderStatusEvent {
  id             String       @id @default(uuid())
  orderId        String
  statusAnterior String?
  statusNovo     String
  observacao     String?
  usuarioId      String?
  origem         String       @default("manual")
  createdAt      DateTime     @default(now())
  order          ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  usuario        User?        @relation(fields: [usuarioId], references: [id])

  @@index([orderId])
  @@index([createdAt])
}

/// Layout de apresentacao da Ordem de Servico (timbrado, configuracao visual).
model OSLayout {
  id             String         @id @default(uuid())
  organizationId String?
  nome           String
  descricao      String?
  tipo           String         @default("personalizado")
  ativo          Boolean        @default(true)
  padrao         Boolean        @default(false)
  configuracao   String         @default("{}")
  timbradoPath   String?
  timbradoApply  String         @default("primeira_pagina")
  margemTopo     Float          @default(0)
  margemBaixo    Float          @default(0)
  margemEsquerda Float          @default(0)
  margemDireita  Float          @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now())
  timbradoBlob   String?
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  orders         ServiceOrder[]

  @@index([organizationId])
  @@index([ativo])
}

/// Alertas internos sobre clientes (visível somente para equipe interna).
model ClientAlert {
  id             String   @id @default(uuid())
  clientId       String
  titulo         String
  descricao      String?
  tipo           String   @default("outro")  // suspensao, atencao, financeiro, contrato, comportamento, suporte, administrativo, outro
  prioridade     String   @default("informativo")  // informativo, atencao, importante, critico
  ativo          Boolean  @default(true)
  criadoPorId    String
  organizationId String?
  dataInicio     DateTime @default(now())
  dataFim        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client       Client       @relation(fields: [clientId], references: [id])
  criadoPor    User         @relation("ClientAlertCreator", fields: [criadoPorId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([clientId])
  @@index([organizationId])
  @@index([ativo])
}

/// Ocorrências operacionais dos analistas (faltas, atrasos, etc.).
model AnalystOccurrence {
  id             String   @id @default(uuid())
  usuarioId      String
  data           DateTime
  tipo           String   // falta, atraso, saida_antecipada, folga, atestado, treinamento, ocorrencia, reconhecimento, observacao, outro
  horas          Float?
  justificativa  String?
  observacao     String?
  criadoPorId    String
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  usuario      User         @relation("AnalystOccurrenceUser", fields: [usuarioId], references: [id])
  criadoPor    User         @relation("AnalystOccurrenceCreator", fields: [criadoPorId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([usuarioId])
  @@index([organizationId])
  @@index([data])
}

model Signature {
  id                  String             @id @default(uuid())
  orderId             String             @unique
  assinanteNome       String
  assinanteCpf        String
  assinanteCargo      String
  assinaturaBase64    String
  ipAssinante         String?
  userAgent           String?
  assinadoEm          DateTime           @default(now())
  tokenAssinatura     String             @unique
  tokenExpiresAt      DateTime
  pdfPath             String?
  createdAt           DateTime           @default(now())
  attempts            Int                @default(0)
  lastError           String?
  messageId           String?
  provider            String?
  rejectedAt          DateTime?
  rejectionReason     String?
  sentAt              DateTime?
  sentBy              String?
  status              String             @default("pendente")
  telefone            String?
  viewedAt            DateTime?
  documentHash        String?
  signatureIdentifier String?            @unique
  signedAt            DateTime?
  timezone            String?
  order               ServiceOrder       @relation(fields: [orderId], references: [id])
  signatureAttempts   SignatureAttempt[]

  @@index([status])
  @@index([tokenExpiresAt])
}

/// Log de tentativas de envio do link de assinatura (resend/tracking).
model SignatureAttempt {
  id           String    @id @default(uuid())
  signatureId  String
  dataHora     DateTime  @default(now())
  usuarioId    String?
  telefone     String?
  provider     String?
  connectionId String?
  messageId    String?
  resultado    String
  erro         String?
  signature    Signature @relation(fields: [signatureId], references: [id], onDelete: Cascade)

  @@index([signatureId])
  @@index([dataHora])
}

model Attachment {
  id           String       @id @default(uuid())
  orderId      String
  filename     String
  originalName String
  mimetype     String
  size         Int
  path         String
  uploadedAt   DateTime     @default(now())
  order        ServiceOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model ServiceOrderItem {
  id            String       @id @default(uuid())
  orderId       String
  descricao     String
  tipo          String       @default("servico")
  quantidade    Float        @default(1)
  valorUnitario Float?
  valorTotal    Float?
  observacoes   String?
  createdAt     DateTime     @default(now())
  order         ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Ticket {
  id                      String                   @id @default(uuid())
  protocolo               String?                  @unique
  externalId              String?                  @unique
  clientId                String?
  contactName             String?
  contactPhone            String?
  assunto                 String?
  categoria               String?
  categoriaId             String?
  status                  String                   @default("aberto")
  canal                   String                   @default("whatsapp")
  etapa                   String                   @default("fila")
  prioridade              String                   @default("media")
  assigneeId              String?
  usuarioId               String?
  idFila                  String?
  ativoId                 String?
  departamentoId          String?
  nivelSuporteId          String?
  whatsappConnectionId    String?
  dataAbertura            DateTime                 @default(now())
  dataFechamento          DateTime?
  dataPrimeiraResposta    DateTime?
  dataInicioAtendimento   DateTime?
  dataConclusao           DateTime?
  dataResolucao           DateTime?
  dataCSAT                DateTime?
  assumedAt               DateTime?
  slaTotalMinutos         Int?
  slaPausadoEm            DateTime?
  slaPausadoTotalMin      Int                      @default(0)
  motivoStatus            String?
  satisfacao              Int?
  resumoFinal             String?
  tipo                    String?
  observacoes             String?
  lastAgentMessageAt      DateTime?
  filaOrder               Int?
  resolvidoPorIa          Boolean                  @default(false)
  iaClassificacao         String?
  iaResumoProblema        String?
  iaSugestaoResposta      String?
  iaNotaEncerramento      String?
  iaAvaliacaoQualidade    String?
  iaCorrecaoOperador      String?
  iaMensagensEnviadas     Int                      @default(0)
  iaPrimeiraRespostaEm    DateTime?
  iaUltimaRespostaEm      DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @default(now())
  tags                    String?
  channelId               String?
  contactJid              String?
  dataFimImplantacao      DateTime?
  dataInicioImplantacao   DateTime?
  horasDesenvolvimento    Float?
  prazoEntrega            DateTime?
  semPrazo                Boolean                  @default(false)
  agentesEnvolvidos       String?                  @default("[]")
  kanbanTaskBoardId       String?
  kanbanTaskId            String?
  primeiroAgenteId        String?
  resolvidoSemAjuda       Boolean?                 @default(true)
  tempoPrimeiroAgenteMin  Int?
  evaluationStatus        String?
  botFluxo                String?
  assuntoId               String?
  organizationId          String?
  aiAgentAudits           AIAgentAudit[]
  aiClassifications       AIClassification[]
  aiCorrections           AICorrection[]
  aiEvaluations           AIEvaluation[]
  aiValidacoes            AIRespostaValidacao[]
  aprovacoes              Aprovacao[]
  auditoriasProfissionais AuditoriaProfissional[]
  csatResposta            CSATResposta?
  channelMessages         ChannelMessage[]
  kanbanTasksKanban       KanbanTask[]             @relation("KanbanTicketTasks")
  messages                Message[]
  notificacoes            Notificacao[]
  orders                  ServiceOrder[]           @relation("OrderTicket")
  assignee                User?                    @relation("TicketAssignee", fields: [assigneeId], references: [id])
  assuntoRef              Assunto?                 @relation(fields: [assuntoId], references: [id])
  ativo                   Ativo?                   @relation(fields: [ativoId], references: [id])
  categoriaRef            Categoria?               @relation(fields: [categoriaId], references: [id])
  channel                 Channel?                 @relation(fields: [channelId], references: [id])
  client                  Client?                  @relation(fields: [clientId], references: [id])
  departamento            Departamento?            @relation(fields: [departamentoId], references: [id])
  fila                    Fila?                    @relation(fields: [idFila], references: [id])
  nivelSuporte            NivelSuporte?            @relation(fields: [nivelSuporteId], references: [id])
  organization            Organization?            @relation(fields: [organizationId], references: [id])
  primeiroAgente          User?                    @relation("TicketPrimeiroAgente", fields: [primeiroAgenteId], references: [id])
  usuario                 User?                    @relation(fields: [usuarioId], references: [id])
  whatsappConnection      WhatsAppConnection?      @relation(fields: [whatsappConnectionId], references: [id])
  activities              TicketActivity[]
  agentInteractions       TicketAgentInteraction[]
  aiLogs                  TicketAiLog[]
  checklists              TicketChecklist[]
  departmentTimes         TicketDepartmentTime[]
  events                  TicketEvent[]
  snapshots               TicketHistory[]
  metrics                 TicketMetrics?
  slaLogs                 TicketSlaLog[]
  stageHistory            TicketStageEvent[]
  timeline                TicketTimeline[]
  waitTimes               TicketWaitTime[]
  timeEntries             TimeEntry[]

  @@index([status])
  @@index([etapa])
  @@index([createdAt])
  @@index([organizationId])
  @@index([dataAbertura])
  @@index([dataFechamento])
  @@index([assigneeId])
  @@index([categoria])
  @@index([assuntoId])
  @@index([prioridade])
  @@index([usuarioId])
  @@index([departamentoId])
  @@index([idFila])
  @@index([resolvidoPorIa])
  @@index([channelId])
  @@index([contactPhone])
  @@index([contactJid])
  @@index([canal])
  @@index([whatsappConnectionId])
  @@index([motivoStatus])
  @@index([evaluationStatus])
  @@index([dataResolucao])
  @@index([departamentoId, dataAbertura])
}

/// Classificacao de IA atribuida a um ticket (historico)
model AIClassification {
  id          String   @id @default(uuid())
  ticketId    String
  categoria   String?
  prioridade  String?
  confianca   Int?
  metodo      String   @default("regex")
  rawResponse String?
  createdAt   DateTime @default(now())
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([categoria])
}

/// Avaliacao de qualidade feita pela IA apos encerramento
model AIEvaluation {
  id             String   @id @default(uuid())
  ticketId       String
  notaQualidade  Int
  pontosForts    String?
  pontosMelhoria String?
  resumo         String?
  modeloUsado    String?
  custoTokens    Float?
  createdAt      DateTime @default(now())
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([notaQualidade])
}

/// Correcao de resposta incorreta do operador (treinamento da IA)
model AICorrection {
  id               String   @id @default(uuid())
  ticketId         String
  mensagemId       String?
  mensagemOriginal String
  tipoErro         String
  correcao         String
  corrigidoPorId   String?
  treinada         Boolean  @default(false)
  createdAt        DateTime @default(now())
  corrigidoPor     User?    @relation(fields: [corrigidoPorId], references: [id])
  ticket           Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([tipoErro])
}

/// Metricas consolidadas de IA por periodo
model AIMetricas {
  id                        String   @id @default(uuid())
  periodo                   String   @unique
  totalChamados             Int      @default(0)
  chamadosIaResolveu        Int      @default(0)
  taxaResolucaoIa           Float    @default(0)
  tempoMedioResolucaoIa     Float    @default(0)
  tempoMedioResolucaoHumano Float    @default(0)
  totalCorrecoes            Int      @default(0)
  taxaSucessoIa             Float    @default(0)
  custoTotalIa              Float    @default(0)
  documentosCriados         Int      @default(0)
  confiancaMediaIa          Float    @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @default(now())
}

/// Log de custos de uso da API Claude (tokens e USD)
model AICostLog {
  id           String   @id @default(uuid())
  modelo       String
  inputTokens  Int
  outputTokens Int
  custoInput   Float
  custoOutput  Float
  custoTotal   Float
  maxTokens    Int
  modulo       String?
  descricao    String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([modelo])
  @@index([modulo])
}

/// Auditoria em tempo real do atendimento do agente
model AIAgentAudit {
  id                    String   @id @default(uuid())
  ticketId              String
  agentId               String
  mensagemId            String?
  conteudoMensagem      String
  notProfissionalismo   Int      @default(0)
  notCordialidade       Int      @default(0)
  notClareza            Int      @default(0)
  notEmpatia            Int      @default(0)
  notaGeral             Float    @default(0)
  classificacao         String   @default("neutro")
  sugestaoResposta      String?
  alertas               String?
  pontosFortes          String?
  pontosMelhoria        String?
  contextoConversa      String?
  modeloUsado           String?
