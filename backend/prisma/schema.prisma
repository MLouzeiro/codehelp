  departamentoId  String?
  ativo           Boolean          @default(true)
  avatar          String?
  cor             String?
  metadata        String?
  lastSyncAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organizationId  String?
  departamento    Departamento?    @relation(fields: [departamentoId], references: [id])
  organization    Organization?    @relation(fields: [organizationId], references: [id])
  channelMessages ChannelMessage[]
  riskLogs        ChannelRiskLog[]
  tickets         Ticket[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

/// Mensagens unificadas de qualquer canal
model ChannelMessage {
  id          String   @id @default(uuid())
  channelId   String
  externalId  String?
  ticketId    String?
  fromMe      Boolean  @default(false)
  contactName String?
  contactId   String?
  content     String?
  mediaUrl    String?
  mimeType    String?
  status      String?  @default("received")
  rawPayload  String?
  createdAt   DateTime @default(now())
  channel     Channel  @relation(fields: [channelId], references: [id])
  ticket      Ticket?  @relation(fields: [ticketId], references: [id])

  @@index([channelId])
  @@index([ticketId])
  @@index([externalId])
  @@index([createdAt])
}

/// Log de riscos e estabilidade por canal
model ChannelRiskLog {
  id          String    @id @default(uuid())
  channelId   String
  tipo        String
  severidade  String    @default("info")
  mensagem    String
  resolvido   Boolean   @default(false)
  resolvidoEm DateTime?
  createdAt   DateTime  @default(now())
  channel     Channel   @relation(fields: [channelId], references: [id])

  @@index([channelId])
  @@index([tipo])
}

/// Integracao externa (ex: CRM) — configuracao da camada de integracao.
/// Campos sensiveis (apiKey/token) sao criptografados em repouso (AES-256-GCM)
/// e nunca retornados por completo nas respostas da API.
model ExternalIntegration {
  id             String                   @id @default(uuid())
  nome           String
  slug           String
  tipo           String                   @default("crm")
  baseUrl        String
  authType       String                   @default("api_key")
  apiKeyEnc      String?
  tokenEnc       String?
  headersJson    String                   @default("{}")
  timeoutMs      Int                      @default(15000)
  ativo          Boolean                  @default(true)
  webhookPath    String?
  webhookSecret  String?
  lastTestAt     DateTime?
  lastTestStatus String?
  lastTestError  String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organizationId String?
  organization   Organization?            @relation(fields: [organizationId], references: [id])
  logs           ExternalIntegrationLog[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

/// Log de auditoria das chamadas de integracao (inbound/outbound)
model ExternalIntegrationLog {
  id            String               @id @default(uuid())
  integrationId String?
  direction     String               @default("outbound")
  endpoint      String?
  method        String?
  status        Int?
  requestBody   String?
  responseBody  String?
  error         String?
  durationMs    Int?
  createdAt     DateTime             @default(now())
  integration   ExternalIntegration? @relation(fields: [integrationId], references: [id])

  @@index([integrationId])
  @@index([createdAt])
}

/// Configuracao de SLA por prioridade
model SLAConfig {
  id                         String        @id @default(uuid())
  prioridade                 String
  slaMinutosPrimeiraResposta Int           @default(60)
  slaMinutosResolucao        Int           @default(240)
  alerta75Porcento           Boolean       @default(true)
  alerta90Porcento           Boolean       @default(true)
  ativo                      Boolean       @default(true)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @default(now())
  organizationId             String?
  organization               Organization? @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, prioridade])
  @@index([organizationId])
}

/// Categoria de ticket (formalizacao das categorias existentes)
model Categoria {
  id             String        @id @default(uuid())
  slug           String
  nome           String
  descricao      String?
  cor            String        @default("#3b82f6")
  icone          String        @default("tag")
  ordem          Int           @default(0)
  ativo          Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())
  departamentoId String?
  organizationId String?
  assuntos       Assunto[]
  departamento   Departamento? @relation("CategoriaDepartamento", fields: [departamentoId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  articles       KBArticle[]
  tickets        Ticket[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

/// Assunto de ticket (hierarquia Categoria -> Assunto)
model Assunto {
  id               String        @id @default(uuid())
  slug             String
  nome             String
  descricao        String?
  categoriaId      String
  icone            String        @default("tag")
  cor              String        @default("#3b82f6")
  prioridadePadrao String        @default("media")
  slaPadraoMin     Int?
  departamentoId   String?
  idFila           String?
  ordem            Int           @default(0)
  ativo            Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now())
  organizationId   String?
  categoria        Categoria     @relation(fields: [categoriaId], references: [id])
  departamento     Departamento? @relation("AssuntoDepartamento", fields: [departamentoId], references: [id])
  fila             Fila?         @relation("AssuntoFila", fields: [idFila], references: [id])
  organization     Organization? @relation(fields: [organizationId], references: [id])
  tickets          Ticket[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([categoriaId])
  @@index([departamentoId])
  @@index([idFila])
  @@index([ativo])
}

/// Ativo (asset) - software/hardware/servico/sistema vinculado a um cliente
model Ativo {
  id        String   @id @default(uuid())
  nome      String
  tipo      String
  descricao String?
  serial    String?
  clienteId String?
  metadata  String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  cliente   Client?  @relation(fields: [clienteId], references: [id])
  tickets   Ticket[]
}

/// Artigo da Base de Conhecimento
model KBArticle {
  id             String             @id @default(uuid())
  slug           String
  titulo         String
  conteudo       String
  resumo         String?
  categoriaId    String?
  tags           String             @default("")
  autorId        String?
  passos         String?
  imagens        String?
  versaoAtual    Int                @default(1)
  visualizacoes  Int                @default(0)
  util           Int                @default(0)
  inutil         Int                @default(0)
  publicado      Boolean            @default(false)
  ordem          Int                @default(0)
  ativo          Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now())
  organizationId String?
  autor          User?              @relation("KBArticleAutor", fields: [autorId], references: [id])
  categoria      Categoria?         @relation(fields: [categoriaId], references: [id])
  organization   Organization?      @relation(fields: [organizationId], references: [id])
  versoes        KBArticleVersion[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([categoriaId])
  @@index([autorId])
  @@index([publicado])
}

/// Historico de versoes do artigo KB
model KBArticleVersion {
  id        String    @id @default(uuid())
  articleId String
  versao    Int
  titulo    String
  conteudo  String
  resumo    String?
  passos    String?
  imagens   String?
  autorId   String?
  createdAt DateTime  @default(now())
  article   KBArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  autor     User?     @relation("KBArticleVersionAutor", fields: [autorId], references: [id])

  @@unique([articleId, versao])
}

/// Resposta CSAT (pesquisa de satisfacao)
model CSATResposta {
  id            String    @id @default(uuid())
  ticketId      String    @unique
  nota          Int?
  comentario    String?
  tokenResposta String    @unique @default(uuid())
  enviadoEm     DateTime?
  respondidoEm  DateTime?
  createdAt     DateTime  @default(now())
  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([respondidoEm])
  @@index([nota])
}

/// Notificacao interna para usuario
model Notificacao {
  id             String        @id @default(uuid())
  tipo           String
  mensagem       String
  destinatarioId String
  ticketId       String?
  dados          String?
  lida           Boolean       @default(false)
  createdAt      DateTime      @default(now())
  organizationId String?
  destinatario   User          @relation(fields: [destinatarioId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  ticket         Ticket?       @relation(fields: [ticketId], references: [id])

  @@index([organizationId])
  @@index([destinatarioId])
  @@index([ticketId])
  @@index([lida])
  @@index([destinatarioId, lida])
}

/// Fluxo de autorização formal para ações que exigem aprovação
model Aprovacao {
  id                String        @id @default(uuid())
  ticketId          String
  solicitadoPorId   String
  aprovadoPorId     String?
  tipo              String        @default("geral")
  motivo            String
  observacao        String?
  status            String        @default("pendente")
  valorAprovado     Float?
  dataSolicitacao   DateTime      @default(now())
  dataDecisao       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now())
  canal             String        @default("interno")
  expiraEm          DateTime?
  telefoneAprovador String?
  token             String?       @unique
  organizationId    String?
  aprovadoPor       User?         @relation("AprovacaoAprovador", fields: [aprovadoPorId], references: [id])
  organization      Organization? @relation(fields: [organizationId], references: [id])
  solicitadoPor     User          @relation("AprovacaoSolicitante", fields: [solicitadoPorId], references: [id])
  ticket            Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

/// Regra de automacao WHEN/IF/THEN
model AutomationRule {
  id             String        @id @default(uuid())
  nome           String
  descricao      String?
  trigger        String
  condicoes      String        @default("[]")
  acoes          String        @default("[]")
  logicOperator  String        @default("all")
  ativo          Boolean       @default(true)
  ordem          Int           @default(0)
  autorId        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

/// Permissao por role (override da matriz padrao)
/// Se `granted` e true, libera; se e false, nega; se nao existe registro, usa default do codigo.
model RolePermission {
  id        String   @id @default(uuid())
  role      String
  resource  String
  action    String
  granted   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([role, resource, action])
  @@index([role])
}

/// Feriado nacional/estadual/municipal para bloqueio do horario comercial
/// data: se recorrente=true, considera apenas mes/dia; senao considera data completa
model Feriado {
  id             String        @id @default(uuid())
  data           DateTime
  nome           String
  tipo           String        @default("nacional")
  recorrente     Boolean       @default(false)
  ativo          Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([data])
}

/// Tabela pivô: Usuario pode pertencer a multiplos departamentos
model UserDepartamento {
  id             String       @id @default(uuid())
  userId         String
  departamentoId String
  createdAt      DateTime     @default(now())
  departamento   Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, departamentoId])
  @@index([departamentoId])
}

/// Configuracao de cobranca do cliente (terminais, hostlinks, interfaces, exames)
model ClientBilling {
  id            String           @id @default(uuid())
  clientId      String
  tipo          String
  quantidade    Int              @default(0)
  valorUnitario Float            @default(0)
  ativo         Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now())
  historico     BillingHistory[]
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, tipo])
  @@index([clientId])
  @@index([tipo])
}

/// Historico de alteracoes de quantidade (audit trail)
model BillingHistory {
  id                 String        @id @default(uuid())
  billingId          String
  clienteId          String
  tipo               String
  quantidadeAnterior Int
  quantidadeNova     Int
  valorUnitario      Float
  usuarioId          String?
  motivo             String?
  createdAt          DateTime      @default(now())
  billing            ClientBilling @relation(fields: [billingId], references: [id], onDelete: Cascade)
  client             Client        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuario            User?         @relation(fields: [usuarioId], references: [id])

  @@index([billingId])
  @@index([clienteId])
  @@index([createdAt])
}

/// Pendencia de cobranca mensal
model BillingPendency {
  id           String    @id @default(uuid())
  clienteId    String
  tipo         String
  periodo      String
  quantidade   Int
  valorTotal   Float
  status       String    @default("pendente")
  notificadoEm DateTime?
  resolvidoEm  DateTime?
  resolvidoPor String?
  observacao   String?
  createdAt    DateTime  @default(now())
  client       Client    @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, tipo, periodo])
  @@index([clienteId])
  @@index([status])
  @@index([periodo])
}

/// Evento atomico do ticket (criacao, mensagem, atribuicao, movimentacao, SLA, IA, etc.)
/// Cada linha e imutavel — audit trail completo do lifetime do ticket.
model TicketEvent {
  id         String   @id @default(uuid())
  ticketId   String
  tipo       String
  descricao  String?
  dados      String?
  usuarioId  String?
  isSystem   Boolean  @default(false)
  isAi       Boolean  @default(false)
  mensagemId String?
  metadata   String?
  createdAt  DateTime @default(now())
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuario    User?    @relation(fields: [usuarioId], references: [id])

  @@index([ticketId])
  @@index([tipo])
  @@index([createdAt])
  @@index([usuarioId])
  @@index([ticketId, tipo])
}

/// Timeline horizontal do ticket — eventos pre-calculados com delta times entre etapas.
/// Atualizado a cada movimentacao para evitar calculos em runtime.
model TicketTimeline {
  id                    String    @id @default(uuid())
  ticketId              String
  etapa                 String
  dataEntrada           DateTime
  dataSaida             DateTime?
  duracaoMinutos        Int?
  duracaoBusinessMin    Int?
  responsavelAnteriorId String?
  responsavelNovoId     String?
  motivoMudanca         String?
  isPaused              Boolean   @default(false)
  pausaTotalMinutos     Int       @default(0)
  createdAt             DateTime  @default(now())
  responsavelAnterior   User?     @relation("TimelineResponsavelAnterior", fields: [responsavelAnteriorId], references: [id])
  responsavelNovo       User?     @relation("TimelineResponsavelNovo", fields: [responsavelNovoId], references: [id])
  ticket                Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([etapa])
  @@index([dataEntrada])
  @@index([ticketId, dataEntrada])
}

/// Metricas consolidadas do ticket — 15 tempos calculados e cacheados.
/// Atualizado quando o ticket e movimentado ou fechado.
model TicketMetrics {
  id                          String    @id @default(uuid())
  ticketId                    String    @unique
  tempoTotalMin               Int       @default(0)
  tempoPrimeiraRespostaMin    Int?
  tempoPrimeiraRespostaIaMin  Int?
  tempoPrimeiraRespostaHumMin Int?
  tempoEmAtendimentoMin       Int       @default(0)
  tempoAguardandoClienteMin   Int       @default(0)
  tempoAguardandoTerceiroMin  Int       @default(0)
  tempoFilaMin                Int       @default(0)
  tempoResolucaoIaMin         Int?
  tempoResolucaoHumanoMin     Int?
  tempoLeadTimeMin            Int       @default(0)
  tempoUtilMin                Int       @default(0)
  tempoCorridoMin             Int       @default(0)
  tempoForaExpedienteMin      Int       @default(0)
  tempoParadoMin              Int       @default(0)
  totalMensagens              Int       @default(0)
  mensagensCliente            Int       @default(0)
  mensagensAgente             Int       @default(0)
  mensagensBot                Int       @default(0)
  totalReaberturas            Int       @default(0)
  totalEscalonamentos         Int       @default(0)
  slaPrazoMinutos             Int?
  slaConsumidoMinutos         Int       @default(0)
  slaRestanteMinutos          Int       @default(0)
  slaPercentualConsumido      Float     @default(0)
  slaStatus                   String?
  csatNota                    Int?
  csatRespondido              Boolean   @default(false)
  resolvidoPorIa              Boolean   @default(false)
  iaConfiancaMedia            Float?
  iaTotalInteracoes           Int       @default(0)
  iaCustoTotalUsd             Float     @default(0)
  iaCustoTotalBrl             Float     @default(0)
  primeiraRespostaEm          DateTime?
  ultimoAtendimentoEm         DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @default(now())
  ticket                      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([slaStatus])
  @@index([resolvidoPorIa])
}

/// Log de lifecycle do SLA — cada transicao de estado e registrada.
model TicketSlaLog {
  id           String   @id @default(uuid())
  ticketId     String
  acao         String
  slaMinutos   Int
  percentual   Float?
  restantesMin Int?
  motivo       String?
  dados        String?
  usuarioId    String?
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuario      User?    @relation(fields: [usuarioId], references: [id])

  @@index([ticketId])
  @@index([acao])
  @@index([createdAt])
}

/// Atividade de usuario no ticket — visualizacoes, edicoes, notas internas.
model TicketActivity {
  id        String   @id @default(uuid())
  ticketId  String
  usuarioId String?
  tipo      String
  descricao String?
  dados     String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuario   User?    @relation(fields: [usuarioId], references: [id])

  @@index([ticketId])
  @@index([usuarioId])
  @@index([tipo])
  @@index([createdAt])
}

/// Tempo de espera do ticket em cada etapa — registro granular.
model TicketWaitTime {
  id          String    @id @default(uuid())
  ticketId    String
  etapa       String
  dataEntrada DateTime
  dataSaida   DateTime?
  duracaoMin  Int?
  motivo      String?
  usuarioId   String?
  createdAt   DateTime  @default(now())
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuario     User?     @relation(fields: [usuarioId], references: [id])

  @@index([ticketId])
  @@index([etapa])
  @@index([dataEntrada])
  @@index([ticketId, etapa])
}

/// Log de processamento de IA no ticket — cada interacao com a IA e registrada.
model TicketAiLog {
  id                     String   @id @default(uuid())
  ticketId               String
  tipo                   String
  modelo                 String?
  inputTokens            Int?
  outputTokens           Int?
  custoUsd               Float?
  custoBrl               Float?
  latenciaMs             Int?
  confianca              Float?
  resultado              String?
  correcaoId             String?
  erro                   String?
  duracaoProcessamentoMs Int?
  createdAt              DateTime @default(now())
  ticket                 Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([tipo])
  @@index([modelo])
  @@index([createdAt])
}

/// Performance consolidada por agente/equipe — metricas agregadas por periodo.
model TicketPerformance {
  id                      String   @id @default(uuid())
  periodo                 String
  tipoPeriodo             String   @default("mensal")
  usuarioId               String?
  departamentoId          String?
  ticketsRecebidos        Int      @default(0)
  ticketsResolvidos       Int      @default(0)
  ticketsEscalonados      Int      @default(0)
  ticketsReabertos        Int      @default(0)
  ticketsCancelados       Int      @default(0)
  mttrMin                 Float    @default(0)
  mttaMin                 Float    @default(0)
  mtfaMin                 Float    @default(0)
  mtFilaMin               Float    @default(0)
  slaCompliancePct        Float    @default(0)
  slaViolados             Int      @default(0)
  slaNoPrazo              Int      @default(0)
  csatMedio               Float?
  csatTotalRespostas      Int      @default(0)
  fcrPct                  Float    @default(0)
  iaResolveu              Int      @default(0)
  iaConfiancaMedia        Float?
  iaCustoTotalUsd         Float    @default(0)
  totalMensagensEnviadas  Int      @default(0)
  totalMensagensRecebidas Int      @default(0)
  tempoAtivoMinutos       Float    @default(0)
  createdAt               DateTime @default(now())
  usuario                 User?    @relation(fields: [usuarioId], references: [id])

  @@unique([periodo, tipoPeriodo, usuarioId, departamentoId])
  @@index([periodo])
  @@index([usuarioId])
  @@index([departamentoId])
}

/// Respostas propostas pela IA aguardando validação de atendentes humanos
model AIRespostaValidacao {
  id               String    @id @default(uuid())
  ticketId         String
  mensagemCliente  String
  respostaProposta String
  assunto          String?
  prioridade       String?
  confianca        Float?
  status           String    @default("pendente")
  validacoesCount  Int       @default(0)
  validacaoIds     String[]
  respostaFinal    String?
  enviadaEm        DateTime?
  criadaPorIaEm    DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  ticket           Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([status])
  @@index([createdAt])
}

/// ── Time Tracking: registro de horas por atividade ───────────────────
model TimeEntry {
  id              String           @id @default(uuid())
  usuarioId       String
  ticketId        String?
  orderId         String?
  projectId       String?
  tipo            String           @default("suporte")
  descricao       String?
  dataInicio      DateTime         @default(now())
  dataFim         DateTime?
  duracaoMin      Int?
  billable        Boolean          @default(true)
  faturado        Boolean          @default(false)
  tags            String[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  clienteId       String?
  setorId         String?
  tarefaId        String?
  pausado         Boolean          @default(false)
  pausadoEm       DateTime?
  pausadoTotalMin Int              @default(0)
  cliente         Client?          @relation(fields: [clienteId], references: [id])
  order           ServiceOrder?    @relation(fields: [orderId], references: [id])
  setor           Departamento?    @relation(fields: [setorId], references: [id])
  tarefa          KanbanTask?      @relation(fields: [tarefaId], references: [id])
  ticket          Ticket?          @relation(fields: [ticketId], references: [id])
  usuario         User             @relation(fields: [usuarioId], references: [id])
  blocos          TimeEntryBlock[]

  @@index([usuarioId])
  @@index([ticketId])
  @@index([orderId])
  @@index([clienteId])
  @@index([tarefaId])
  @@index([setorId])
  @@index([tipo])
  @@index([dataInicio])
  @@index([billable])
}

/// Blocos de uma sessao de tempo (inicio/pausa/retomada/fim) para auditoria de horario.
model TimeEntryBlock {
  id          String    @id @default(uuid())
  timeEntryId String
  tipo        String
  data        DateTime  @default(now())
  usuarioId   String?
  observacao  String?
  createdAt   DateTime  @default(now())
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  usuario     User?     @relation(fields: [usuarioId], references: [id])

  @@index([timeEntryId])
  @@index([tipo])
  @@index([data])
}

/// Tempo que a tarefa permaneceu em cada coluna/etapa (para analises posteriores).
model KanbanStageTime {
  id          String        @id @default(uuid())
  taskId      String
  columnId    String?
  columnNome  String
  dataEntrada DateTime      @default(now())
  dataSaida   DateTime?
  duracaoMin  Int?
  usuarioId   String?
  createdAt   DateTime      @default(now())
  column      KanbanColumn? @relation(fields: [columnId], references: [id])
  task        KanbanTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  usuario     User?         @relation(fields: [usuarioId], references: [id])

  @@index([taskId])
  @@index([columnId])
  @@index([dataEntrada])
}

/// Equipe de trabalho (agrupamento opcional alem do departamento).
model Team {
  id             String        @id @default(uuid())
  nome           String
  descricao      String?
  departamentoId String?
  liderId        String?
  ativo          Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())
  organizationId String?
  kanbanTasks    KanbanTask[]
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])
  lider          User?         @relation("TeamLider", fields: [liderId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  membros        TeamMember[]

  @@index([organizationId])
  @@index([departamentoId])
  @@index([ativo])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
}

/// Alertas automaticos sobre tarefas (prazo proximo/atrasado, sem movimentacao, etc).
model TaskAlert {
  id        String     @id @default(uuid())
  taskId    String
  tipo      String
  mensagem  String
  lida      Boolean    @default(false)
  createdAt DateTime   @default(now())
  task      KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([tipo])
  @@index([lida])
  @@index([createdAt])
}

/// Checklist dentro de um ticket (tarefas a serem cumpridas)
model TicketChecklist {
  id            String   @id @default(uuid())
  ticketId      String
  titulo        String
  concluida     Boolean  @default(false)
  ordem         Int      @default(0)
  responsavelId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  responsavel   User?    @relation(fields: [responsavelId], references: [id])
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([concluida])
}

/// Template de checklist reutilizável (pode ser usado em tickets e kanban)
model ChecklistTemplate {
  id             String        @id @default(uuid())
  nome           String
  descricao      String?
  categoria      String?       @default("geral")
  items          String        @default("[]")
  publico        Boolean       @default(false)
  criadorId      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())
  organizationId String?
  criador        User?         @relation(fields: [criadorId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([criadorId])
  @@index([categoria])
}

/// Tempo gasto por departamento/setor em um ticket
model TicketDepartmentTime {
  id             String       @id @default(uuid())
  ticketId       String
  departamentoId String
  userId         String?
  dataInicio     DateTime     @default(now())
  dataFim        DateTime?
  duracaoMin     Int?
  kanbanTaskId   String?
  createdAt      DateTime     @default(now())
  departamento   Departamento @relation(fields: [departamentoId], references: [id])
  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([departamentoId])
  @@index([ticketId, departamentoId])
}

/// Registro de interação de agentes no ticket (para FCR)
model TicketAgentInteraction {
  id        String   @id @default(uuid())
  ticketId  String
  usuarioId String
  tipo      String   @default("mensagem")
  conteudo  String?
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuario   User     @relation(fields: [usuarioId], references: [id])

  @@index([ticketId])
  @@index([usuarioId])
  @@index([ticketId, usuarioId])
}

/// Contato ou grupo excluído do fluxo automático do Helpdesk.
/// A mensagem continua chegando no WhatsApp, mas NÃO inicia atendimento.
model ContatoIgnorado {
  id             String    @id @default(uuid())
  tipo           String    @default("contato")
  chave          String    @unique
  nome           String
  motivo         String?
  regra          String    @default("ignorar_helpdesk")
  ignorado       Boolean   @default(true)
  criadoPorId    String?
  reativadoPorId String?
  criadoEm       DateTime  @default(now())
  reativadoEm    DateTime?
  historico      String?
  criadoPor      User?     @relation("ContatoIgnoradoCriadoPor", fields: [criadoPorId], references: [id])
  reativadoPor   User?     @relation("ContatoIgnoradoReativadoPor", fields: [reativadoPorId], references: [id])

  @@index([tipo])
  @@index([ignorado])
  @@index([criadoEm])
}

/// Decisão gerencial estruturada com cadeia de evidências completa.
/// Cada registro representa uma conclusão/decisão da auditoria com:
/// dados analisados, evidências, cálculos, hipóteses, confiança,
/// recomendação, responsável, prazo e resultado posterior.
model DecisionAudit {
  id                String    @id @default(uuid())
  tipo              String                         // reabertura, sla, csat, retrabalho, ociosidade, produtividade, fila, transferencia, csat_baixo, qualidade
  severidade        String    @default("media")    // critica, alta, media, baixa, info
  titulo            String
  problema          String                         // Descrição objetiva do problema
  evidencias        String    @default("[]")       // JSON: [{tipo, dado, valor, comparacao?, fonte?, ticketIds?}]
  comoChegamos      String                         // Fórmula, comparação e critérios utilizados
  oQueDadosMostram  String                         // Interpretação dos dados
  hipotese          String                         // Possível causa (sempre identificada como hipótese)
  impacto           String                         // Consequência operacional
  confianca         String    @default("media")    // alta, media, baixa
  confiancaMotivo   String?                        // Por que esse nível de confiança
  recomendacao      String                         // Ação prática recomendada
  responsavelAcao   String?                        // Quem deve agir
  prazoAcao         String?                        // Quando revisar/executar
  comoVerificar     String?                        // Indicador que deverá melhorar
  resultado         String?                        // Preenchido após a ação
  resultadoData     DateTime?                      // Quando o resultado foi verificado
  status            String    @default("pendente") // pendente, em_acao, concluido, revertido, ignorado
  periodoInicio     DateTime?                      // Início do período analisado
  periodoFim        DateTime?                      // Fim do período analisado
  dadosAnalisados   String    @default("{}")       // JSON: {totalTickets, ticketsFechados, etc.}
  calculos          String    @default("{}")       // JSON: {formula, resultado, comparacao}
  comparacoes       String    @default("[]")       // JSON: [{indicador, valorAtual, valorAnterior, variacao}]
  ticketsEnvolvidos String    @default("[]")       // JSON: [ticketId, ...] - tickets que sustentam a conclusão
  rankingAnalistas  String    @default("[]")       // JSON: [{agenteId, nome, valor, classificacao}]
  padroesDetectados String    @default("[]")       // JSON: [{tipo, descricao, frequencia, confianca}]
  modeloIa          String?                        // Modelo de IA utilizado (se houver)
  dadosIa           String?                        // JSON: dados brutos da IA
  criadoPorId       String?
  revisadoPorId     String?
  revisaoStatus     String    @default("pendente") // pendente, aprovado, rejeitado, reavaliar
  revisaoJustificativa String?
  revisaoEm         DateTime?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt
  organizationId    String?
  criadoPor         User?     @relation("DecisionAuditCriadoPor", fields: [criadoPorId], references: [id])
  revisadoPor       User?     @relation("DecisionAuditRevisadoPor", fields: [revisadoPorId], references: [id])
  organization      Organization? @relation(fields: [organizationId], references: [id])

  @@index([tipo])
  @@index([severidade])
  @@index([status])
  @@index([confianca])
  @@index([criadoEm])
  @@index([periodoInicio, periodoFim])
  @@index([revisaoStatus])
}
