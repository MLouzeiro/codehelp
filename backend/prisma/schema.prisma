generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String                    @id @default(uuid())
  name                        String
  email                       String                    @unique
  password                    String
  role                        String                    @default("tecnico")
  isMaster                    Boolean                   @default(false)
  phone                       String?
  avatar                      String?
  active                      Boolean                   @default(true)
  online                      Boolean                   @default(false)
  lastSeenAt                  DateTime?
  sessionToken                String?                   @unique
  signature                   String?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @default(now())
  aiCorrections               AICorrection[]
  aiAgentAudits               AIAgentAudit[]
  auditoriasAgente            AuditoriaProfissional[]   @relation("AuditoriaAgente")
  auditoriasRevisadas         AuditoriaProfissional[]   @relation("AuditoriaRevisor")
  aprovacoesDecididas         Aprovacao[]               @relation("AprovacaoAprovador")
  aprovacoesSolicitadas       Aprovacao[]               @relation("AprovacaoSolicitante")
  auditLogs                   AuditLog[]
  billingHistory              BillingHistory[]
  clientTechnician            Client[]                  @relation("ClientTechnician")
  contacts                    Contact[]
  kbArticlesAutor             KBArticle[]               @relation("KBArticleAutor")
  kbVersionsAutor             KBArticleVersion[]        @relation("KBArticleVersionAutor")
  kanbanActivities            KanbanActivity[]          @relation("KanbanActivityUsuario")
  kanbanAttachments           KanbanAttachment[]        @relation("KanbanAttachmentUsuario")
  kanbanBoardsCreated         KanbanBoard[]             @relation("KanbanBoardCriador")
  kanbanSubtasks              KanbanSubtask[]           @relation("KanbanSubtaskResponsavel")
  kanbanTasks                 KanbanTask[]              @relation("KanbanTaskResponsavel")
  kanbanTemplates             KanbanTemplate[]          @relation("KanbanTemplateCriador")
  messages                    Message[]
  notificacoes                Notificacao[]
  opportunities               Opportunity[]
  orderCreator                ServiceOrder[]            @relation("OrderCreator")
  orderTechnician             ServiceOrder[]            @relation("OrderTechnician")
  serviceOrderStatusEvents    ServiceOrderStatusEvent[]
  tasks                       Task[]
  ticketsAtendidos            Ticket[]                  @relation("TicketAssignee")
  ticketsPrimeiroAgente       Ticket[]                  @relation("TicketPrimeiroAgente")
  tickets                     Ticket[]
  ticketActivities            TicketActivity[]
  ticketEvents                TicketEvent[]
  ticketPerformance           TicketPerformance[]
  ticketSlaLogs               TicketSlaLog[]
  stageMovements              TicketStageEvent[]
  timelineAnterior            TicketTimeline[]          @relation("TimelineResponsavelAnterior")
  timelineNovo                TicketTimeline[]          @relation("TimelineResponsavelNovo")
  ticketWaitTimes             TicketWaitTime[]
  timeEntries                 TimeEntry[]
  departamentos               UserDepartamento[]
  ticketChecklists            TicketChecklist[]
  checklistTemplates          ChecklistTemplate[]
  agentInteractions           TicketAgentInteraction[]
  departmentTimes             TicketDepartmentTime[]
  contatosIgnoradosCriados    ContatoIgnorado[]         @relation("ContatoIgnoradoCriadoPor")
  contatosIgnoradosReativados ContatoIgnorado[]         @relation("ContatoIgnoradoReativadoPor")
  teamsLider                  Team[]                    @relation("TeamLider")
  teamMemberships             TeamMember[]
  kanbanTasksArquivadas       KanbanTask[]              @relation("KanbanTaskArquivador")
  timeEntryBlocks             TimeEntryBlock[]
  stageTimes                  KanbanStageTime[]
}

model Client {
  id                   String            @id @default(uuid())
  razaoSocial          String
  nomeFantasia         String?
  cnpjCpf              String?
  segmento             String            @default("laboratorio")
  responsavelTecnicoId String?
  telefone             String?
  email                String?
  cidade               String?
  estado               String?
  status               String            @default("ativo")
  origem               String            @default("manual")
  tipoContrato         String?
  valorMensalidade     Float?
  diaVencimento        Int?
  dataInicioContrato   DateTime?
  dataFimContrato      DateTime?
  whatsappContactId    String?
  ativo                Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @default(now())
  ativos               Ativo[]
  billingHistory       BillingHistory[]
  billingPendencies    BillingPendency[]
  responsavelTecnico   User?             @relation("ClientTechnician", fields: [responsavelTecnicoId], references: [id])
  billings             ClientBilling[]
  colaboradores        Colaborador[]
  contacts             Contact[]
  kanbanTasks          KanbanTask[]
  opportunities        Opportunity[]
  serviceOrders        ServiceOrder[]
  tickets              Ticket[]
  timeEntries          TimeEntry[]
  auditLogs            AuditLog[]
}

/// Colaborador de um cliente (pessoa que trabalha na empresa cliente)
/// Diferente de Contact: Contact registra INTERACOES (ligacoes, emails trocados);
/// Colaborador lista PESSOAS que trabalham no cliente.
model Colaborador {
  id          String   @id @default(uuid())
  clientId    String
  nome        String
  cargo       String?
  setor       String?
  email       String?
  telefone    String?
  whatsapp    String?
  principal   Boolean  @default(false)
  observacoes String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Contact {
  id             String   @id @default(uuid())
  clientId       String
  tipo           String
  descricao      String?
  data           DateTime @default(now())
  usuarioId      String
  duracaoMinutos Int?
  createdAt      DateTime @default(now())
  client         Client   @relation(fields: [clientId], references: [id])
  usuario        User     @relation(fields: [usuarioId], references: [id])
}

model Opportunity {
  id                     String    @id @default(uuid())
  clientId               String
  titulo                 String
  valorEstimado          Float?
  etapa                  String    @default("prospeccao")
  probabilidade          Int?      @default(50)
  dataFechamentoPrevista DateTime?
  responsavelId          String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now())
  client                 Client    @relation(fields: [clientId], references: [id])
  responsavel            User      @relation(fields: [responsavelId], references: [id])

  @@index([etapa])
}

model ServiceOrder {
  id                    String                    @id @default(uuid())
  numeroOs              String                    @unique
  clientId              String
  tipoServico           String
  descricaoServico      String?
  sistemasEnvolvidos    String                    @default("[]")
  equipamentos          String?
  tecnicoResponsavelId  String
  valorServico          Float?
  dataEmissao           DateTime                  @default(now())
  dataPrevistaEntrega   DateTime?
  status                String                    @default("rascunho")
  ticketId              String?
  observacoes           String?
  criadoPorId           String
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @default(now())
  dataFimImplantacao    DateTime?
  dataInicioImplantacao DateTime?
  horasDev              Float?                    @default(0)
  horasSuporte          Float?                    @default(0)
  implantacaoConcluida  Boolean                   @default(false)
  precoImplantacao      Float?                    @default(0)
  tipoImplantacao       String?
  dataConclusao         DateTime?
  attachments           Attachment[]
  client                Client                    @relation(fields: [clientId], references: [id])
  criadoPor             User                      @relation("OrderCreator", fields: [criadoPorId], references: [id])
  tecnicoResponsavel    User                      @relation("OrderTechnician", fields: [tecnicoResponsavelId], references: [id])
  ticket                Ticket?                   @relation("OrderTicket", fields: [ticketId], references: [id])
  signature             Signature?
  timeEntries           TimeEntry[]
  statusEvents          ServiceOrderStatusEvent[]
  kanbanTasks           KanbanTask[]

  @@index([status])
  @@index([createdAt])
  @@index([tipoImplantacao])
  @@index([implantacaoConcluida])
}

/// Timeline de status da Ordem de Servico (tempo por status, auditoria).
model ServiceOrderStatusEvent {
  id             String       @id @default(uuid())
  orderId        String
  statusAnterior String?
  statusNovo     String
  observacao     String?
  usuarioId      String?
  origem         String       @default("manual") // manual | sistema | whatsapp | publico
  createdAt      DateTime     @default(now())
  order          ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  usuario        User?        @relation(fields: [usuarioId], references: [id])

  @@index([orderId])
  @@index([createdAt])
}

model Signature {
  id               String       @id @default(uuid())
  orderId          String       @unique
  assinanteNome    String
  assinanteCpf     String
  assinanteCargo   String
  assinaturaBase64 String
  ipAssinante      String?
  userAgent        String?
  assinadoEm       DateTime     @default(now())
  tokenAssinatura  String       @unique
  tokenExpiresAt   DateTime
  pdfPath          String?
  createdAt        DateTime     @default(now())
  order            ServiceOrder @relation(fields: [orderId], references: [id])

  // ── Correcao critica: assinatura de OS (envio/rastreio) ─────────────
  // Status da solicitacao: pendente | enviada | entregue | visualizada |
  // assinada | recusada | expirada | cancelada | erro_envio
  status            String             @default("pendente")
  messageId         String?
  provider          String?
  telefone          String?
  sentAt            DateTime?
  sentBy            String?
  attempts          Int                @default(0)
  lastError         String?
  viewedAt          DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  signatureAttempts SignatureAttempt[]

  @@index([status])
  @@index([tokenExpiresAt])
}

/// Log de tentativas de envio do link de assinatura (resend/tracking).
model SignatureAttempt {
  id           String    @id @default(uuid())
  signatureId  String
  dataHora     DateTime  @default(now())
  usuarioId    String?
  telefone     String?
  provider     String?
  connectionId String?
  messageId    String?
  resultado    String // enviada | erro
  erro         String?
  signature    Signature @relation(fields: [signatureId], references: [id], onDelete: Cascade)

  @@index([signatureId])
  @@index([dataHora])
}

model Attachment {
  id           String       @id @default(uuid())
  orderId      String
  filename     String
  originalName String
  mimetype     String
  size         Int
  path         String
  uploadedAt   DateTime     @default(now())
  order        ServiceOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Ticket {
  id                      String                   @id @default(uuid())
  protocolo               String?                  @unique
  externalId              String?                  @unique
  clientId                String?
  contactName             String?
  contactPhone            String?
  contactJid              String?
  assunto                 String?
  categoria               String?
  categoriaId             String?
  assuntoId               String?
  status                  String                   @default("aberto")
  canal                   String                   @default("whatsapp")
  etapa                   String                   @default("fila")
  prioridade              String                   @default("media")
  assigneeId              String?
  usuarioId               String?
  idFila                  String?
  ativoId                 String?
  departamentoId          String?
  nivelSuporteId          String?
  whatsappConnectionId    String?
  dataAbertura            DateTime                 @default(now())
  dataFechamento          DateTime?
  dataPrimeiraResposta    DateTime?
  dataInicioAtendimento   DateTime?
  dataConclusao           DateTime?
  dataResolucao           DateTime?
  dataCSAT                DateTime?
  evaluationStatus        String?
  assumedAt               DateTime?
  slaTotalMinutos         Int?
  slaPausadoEm            DateTime?
  slaPausadoTotalMin      Int                      @default(0)
  motivoStatus            String?
  satisfacao              Int?
  resumoFinal             String?
  botFluxo                String?
  tipo                    String?
  observacoes             String?
  lastAgentMessageAt      DateTime?
  filaOrder               Int?
  resolvidoPorIa          Boolean                  @default(false)
  iaClassificacao         String?
  iaResumoProblema        String?
  iaSugestaoResposta      String?
  iaNotaEncerramento      String?
  iaAvaliacaoQualidade    String?
  iaCorrecaoOperador      String?
  iaMensagensEnviadas     Int                      @default(0)
  iaPrimeiraRespostaEm    DateTime?
  iaUltimaRespostaEm      DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @default(now())
  tags                    String?
  channelId               String?
  prazoEntrega            DateTime?
  semPrazo                Boolean                  @default(false)
  horasDesenvolvimento    Float?
  dataInicioImplantacao   DateTime?
  dataFimImplantacao      DateTime?
  resolvidoSemAjuda       Boolean?                 @default(true)
  agentesEnvolvidos       String?                  @default("[]")
  primeiroAgenteId        String?
  tempoPrimeiroAgenteMin  Int?
  kanbanTaskId            String?
  kanbanTaskBoardId       String?
  aiClassifications       AIClassification[]
  aiCorrections           AICorrection[]
  aiEvaluations           AIEvaluation[]
  aiAgentAudits           AIAgentAudit[]
  auditoriasProfissionais AuditoriaProfissional[]
  aiValidacoes            AIRespostaValidacao[]
  aprovacoes              Aprovacao[]
  csatResposta            CSATResposta?
  channelMessages         ChannelMessage[]
  messages                Message[]
  notificacoes            Notificacao[]
  orders                  ServiceOrder[]           @relation("OrderTicket")
  assignee                User?                    @relation("TicketAssignee", fields: [assigneeId], references: [id])
  ativo                   Ativo?                   @relation(fields: [ativoId], references: [id])
  categoriaRef            Categoria?               @relation(fields: [categoriaId], references: [id])
  assuntoRef              Assunto?                 @relation(fields: [assuntoId], references: [id])
  channel                 Channel?                 @relation(fields: [channelId], references: [id])
  client                  Client?                  @relation(fields: [clientId], references: [id])
  departamento            Departamento?            @relation(fields: [departamentoId], references: [id])
  fila                    Fila?                    @relation(fields: [idFila], references: [id])
  nivelSuporte            NivelSuporte?            @relation(fields: [nivelSuporteId], references: [id])
  usuario                 User?                    @relation(fields: [usuarioId], references: [id])
  primeiroAgente          User?                    @relation("TicketPrimeiroAgente", fields: [primeiroAgenteId], references: [id])
  whatsappConnection      WhatsAppConnection?      @relation(fields: [whatsappConnectionId], references: [id])
  activities              TicketActivity[]
  aiLogs                  TicketAiLog[]
  events                  TicketEvent[]
  snapshots               TicketHistory[]
  metrics                 TicketMetrics?
  slaLogs                 TicketSlaLog[]
  stageHistory            TicketStageEvent[]
  timeline                TicketTimeline[]
  waitTimes               TicketWaitTime[]
  timeEntries             TimeEntry[]
  checklists              TicketChecklist[]
  departmentTimes         TicketDepartmentTime[]
  agentInteractions       TicketAgentInteraction[]
  kanbanTasksKanban       KanbanTask[]             @relation("KanbanTicketTasks")

  @@index([status])
  @@index([etapa])
  @@index([createdAt])
  @@index([dataAbertura])
  @@index([dataFechamento])
  @@index([assigneeId])
  @@index([categoria])
  @@index([assuntoId])
  @@index([prioridade])
  @@index([usuarioId])
  @@index([departamentoId])
  @@index([idFila])
  @@index([resolvidoPorIa])
  @@index([channelId])
  @@index([contactPhone])
  @@index([contactJid])
  // Índices de roteamento de canal e auditoria (aditivos, sem impacto em fluxo).
  // canal → dashboards/auditoria "tickets por canal"
  @@index([canal])
  // whatsappConnectionId → filtro por instância/canal de origem do ticket (roteamento)
  @@index([whatsappConnectionId])
  // motivoStatus → auditoria de encerramento/retrabalho por motivo
  @@index([motivoStatus])
  // evaluationStatus → fluxo CSAT/confirmação de resolução (busca por pendências)
  @@index([evaluationStatus])
  // dataResolucao → indicadores TMR/tempo de resolução
  @@index([dataResolucao])
  // [departamentoId, dataAbertura] → fila/posição e dashboards por departamento+período
  @@index([departamentoId, dataAbertura])
}

/// Classificacao de IA atribuida a um ticket (historico)
model AIClassification {
  id          String   @id @default(uuid())
  ticketId    String
  categoria   String?
  prioridade  String?
  confianca   Int?
  metodo      String   @default("regex")
  rawResponse String?
  createdAt   DateTime @default(now())
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([categoria])
}

/// Avaliacao de qualidade feita pela IA apos encerramento
model AIEvaluation {
  id             String   @id @default(uuid())
  ticketId       String
  notaQualidade  Int
  pontosForts    String?
  pontosMelhoria String?
  resumo         String?
  modeloUsado    String?
  custoTokens    Float?
  createdAt      DateTime @default(now())
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([notaQualidade])
}

/// Correcao de resposta incorreta do operador (treinamento da IA)
model AICorrection {
  id               String   @id @default(uuid())
  ticketId         String
  mensagemId       String?
  mensagemOriginal String
  tipoErro         String
  correcao         String
  corrigidoPorId   String?
  treinada         Boolean  @default(false)
  createdAt        DateTime @default(now())
  corrigidoPor     User?    @relation(fields: [corrigidoPorId], references: [id])
  ticket           Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([tipoErro])
}

/// Metricas consolidadas de IA por periodo
model AIMetricas {
  id                        String   @id @default(uuid())
  periodo                   String   @unique
  totalChamados             Int      @default(0)
  chamadosIaResolveu        Int      @default(0)
  taxaResolucaoIa           Float    @default(0)
  tempoMedioResolucaoIa     Float    @default(0)
  tempoMedioResolucaoHumano Float    @default(0)
  totalCorrecoes            Int      @default(0)
  taxaSucessoIa             Float    @default(0)
  custoTotalIa              Float    @default(0)
  documentosCriados         Int      @default(0)
  confiancaMediaIa          Float    @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @default(now())
}

/// Auditoria em tempo real do atendimento do agente
model AIAgentAudit {
  id                  String   @id @default(uuid())
  ticketId            String
  agentId             String
  mensagemId          String?
  conteudoMensagem    String
  notProfissionalismo Int      @default(0)
  notCordialidade     Int      @default(0)
  notClareza          Int      @default(0)
  notEmpatia          Int      @default(0)
  notaGeral           Float    @default(0)
  classificacao       String   @default("neutro")
  sugestaoResposta    String?
  alertas             String?
  pontosFortes        String?
  pontosMelhoria      String?
  contextoConversa    String?
  modeloUsado         String?
  custoTokens         Float?
  processadoEm        DateTime @default(now())
  ticket              Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  agent               User     @relation(fields: [agentId], references: [id])

  @@index([ticketId])
  @@index([agentId])
  @@index([classificacao])
  @@index([processadoEm])
}

/// Detecção de encerramento (prematuro / resolução real / reabertura) por ticket,
/// persistida automaticamente no fechamento e agregada por agente no monitor.
model AIAgentClosureAudit {
  id                         String   @id @default(uuid())
  ticketId                   String   @unique
  protocolo                  String?
  agentId                    String?
  tipo                       String // encerramento_prematuro | resolucao_real | reabertura | sem_dados
  riscoReabertura            String  @default("BAIXO") // BAIXO | MÉDIO | ALTO | CRÍTICO
  nota                       Float   @default(0) // 0-10 (10 = encerramento perfeito)
  diagnostico                String?
  detalhes                   String? // JSON array
  recomendaReabertura        Boolean @default(false)
  semConfirmacao             Boolean @default(false)
  motivoStatus               String?
  clienteVoltou              Boolean @default(false)
  mensagensAposEncerramento  Int     @default(0)
  csatNota                   Float?
  csatRespondido             Boolean @default(false)
  analiseIa                  Boolean @default(false)
  ticketReaberturaId         String?
  dataFechamento             DateTime?
  processadoEm               DateTime @default(now())

  @@index([agentId])
  @@index([tipo])
  @@index([riscoReabertura])
  @@index([processadoEm])
}

/// Auditoria profissional inteligente de atendimento por ticket
/// 14 categorias 0-100, evidencias estruturadas, tomada de decisão e revisão humana.
model AuditoriaProfissional {
  id             String  @id @default(uuid())
  ticketId       String
  protocolo      String?
  contactName    String?
  agenteId       String?
  clienteId      String?
  departamentoId String?
  categoria      String?
  status         String  @default("PENDENTE") // PENDENTE | ANALISANDO | ANALISADO | REVISAR | ERRO
  versao         Int     @default(1)

  // Notas 0-100 por categoria
  notaComunicacao         Float @default(0)
  notaProfissionalismo    Float @default(0)
  notaEmpatia             Float @default(0)
  notaClareza             Float @default(0)
  notaFormalidade         Float @default(0)
  notaConhecimentoTecnico Float @default(0)
  notaDiagnostico         Float @default(0)
  notaResolucao           Float @default(0)
  notaGestaoTempo         Float @default(0)
  notaProcesso            Float @default(0)
  notaEncerramento        Float @default(0)
  notaSeguranca           Float @default(0)
  notaResponsabilidade    Float @default(0)
  notaSatisfacaoCliente   Float @default(0)
  notaGeral               Float @default(0)

  classificacao             String  @default("ATENCAO") // EXCELENTE | MUITO_BOM | BOM | ATENCAO | ABAIXO_DA_MEDIA | CRITICO
  classificacaoResolucao    String  @default("SEM_CONFIRMACAO") // RESOLVIDO | PROVAVELMENTE_RESOLVIDO | PARCIALMENTE_RESOLVIDO | NAO_RESOLVIDO | SEM_CONFIRMACAO | REABERTO | TRANSFERIDO | PRECISOU_DE_DESENVOLVIMENTO | IMPLANTACAO | OUTRO_SETOR
  classificacaoEncerramento String  @default("SEM_ENCERRAMENTO") // ADEQUADO | PARCIAL | INADEQUADO | SEM_ENCERRAMENTO
  padrao                    String  @default("EVENTO_ISOLADO") // EVENTO_ISOLADO | PADRAO_RECORRENTE | PROBLEMA_FREQUENTE | PROBLEMA_CRITICO | PROBLEMA_SISTEMICO
  confiancaMedia            Float   @default(0) // 0-100
  analiseInconclusiva       Boolean @default(false)

  // Análises qualitativas
  resumoExecutivo     String?
  analiseQualitativa  String?
  explicacaoLeiga     String?
  evidenciaProblemas  String? // JSON: [{descricao, trecho, autor, data, gravidade, impacto, confianca, categoria}]
  pontosFortes        String? // JSON: [{descricao, trecho, confianca}]
  riscos              String? // JSON: [{tipo, descricao, gravidade, confianca}]
  recomendacoes       String? // JSON: [{descricao, prioridade, meta, acao}]
  planoMelhoria       String? // JSON: [{descricao, prazo, acompanhamento}]
  alertas             String? // JSON: [{tipo, mensagem, gravidade}]
  riscoInsatisfacao   String  @default("BAIXO") // BAIXO | MEDIO | ALTO | CRITICO
  retrabalho          Boolean @default(false)
  custoOperacionalMin Float? // minutos estimados de retrabalho/custo
  reaberto            Boolean @default(false)
  numeroReaberturas   Int     @default(0)

  // Revisão humana
  revisaoStatus        String? // CONFIRMADO | DISCORDO | REVISAR | NAO_SE_APLICA
  revisaoJustificativa String?
  revisadoPorId        String?
  revisadoEm           DateTime?

  modeloUsado String?
  custoTokens Float?
  auditadoEm  DateTime  @default(now())
  analisadoEm DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())

  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  agente      User?  @relation("AuditoriaAgente", fields: [agenteId], references: [id])
  revisadoPor User?  @relation("AuditoriaRevisor", fields: [revisadoPorId], references: [id])

  @@index([ticketId])
  @@index([agenteId])
  @@index([clienteId])
  @@index([departamentoId])
  @@index([categoria])
  @@index([status])
  @@index([classificacao])
  @@index([auditadoEm])
}

model Message {
  id        String   @id @default(uuid())
  ticketId  String
  fromMe    Boolean  @default(false)
  content   String?
  mediaUrl  String?
  mimeType  String?
  source    String?  @default("agent")
  tipo      String?  @default("message")
  usuarioId String?
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())
  phone     String?
  provider  String?
  status    String?  @default("sent")
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  usuario   User?    @relation(fields: [usuarioId], references: [id])

  @@index([ticketId])
  @@index([fromMe])
  @@index([status])
}

model Task {
  id             String    @id @default(uuid())
  titulo         String
  descricao      String?
  status         String    @default("aberta")
  prioridade     String    @default("media")
  responsavelId  String?
  projeto        String?
  sprint         String?
  dataVencimento DateTime?
  dataConclusao  DateTime?
  ordem          Int?
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())
  responsavel    User?     @relation(fields: [responsavelId], references: [id])

  @@index([responsavelId])
  @@index([status])
}

model KanbanBoard {
  id         String         @id @default(uuid())
  nome       String         @unique
  descricao  String?
  icone      String?        @default("layout")
  cor        String?        @default("#3b82f6")
  criadorId  String?
  ativo      Boolean        @default(true)
  ordem      Int            @default(0)
  templateId String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @default(now())
  criador    User?          @relation("KanbanBoardCriador", fields: [criadorId], references: [id])
  columns    KanbanColumn[]
  tags       KanbanTag[]
  tasks      KanbanTask[]
}

model KanbanColumn {
  id         String            @id @default(uuid())
  boardId    String
  nome       String
  cor        String?           @default("#6b7280")
  icone      String?
  ordem      Int               @default(0)
  wipLimit   Int?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @default(now())
  hidden     Boolean           @default(false)
  board      KanbanBoard       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks      KanbanTask[]
  stageTimes KanbanStageTime[]

  @@index([boardId])
}

model KanbanTask {
  id               String             @id @default(uuid())
  numero           Int                @default(0)
  titulo           String
  descricao        String?
  columnId         String
  boardId          String
  responsavelId    String?
  clientId         String?
  ticketId         String?
  orderId          String?
  departamentoId   String?
  equipeId         String?
  prioridade       String             @default("media")
  categoria        String?
  classificacao    String?
  tipoTarefa       String             @default("outro") // dev | implantacao | atendimento | outro
  statusPrazo      String? // no_prazo | proxima | atencao | atrasada | concluida
  dataInicio       DateTime?
  prazoEntrega     DateTime?
  dataConclusao    DateTime?
  estimativaHoras  Float?
  horasTrabalhadas Float?             @default(0)
  ordem            Int                @default(0)
  ativo            Boolean            @default(true)
  arquivado        Boolean            @default(false)
  arquivadoEm      DateTime?
  arquivadoPorId   String?
  restauradoEm     DateTime?
  reabertoEm       DateTime?
  reabertoMotivo   String?
  deletedAt        DateTime?
  deletedBy        String?
  deleteReason     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now())
  activities       KanbanActivity[]
  attachments      KanbanAttachment[]
  subtasks         KanbanSubtask[]
  board            KanbanBoard        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  client           Client?            @relation(fields: [clientId], references: [id])
  column           KanbanColumn       @relation(fields: [columnId], references: [id], onDelete: Cascade)
  departamento     Departamento?      @relation(fields: [departamentoId], references: [id])
  equipe           Team?              @relation(fields: [equipeId], references: [id])
  ticket           Ticket?            @relation("KanbanTicketTasks", fields: [ticketId], references: [id])
  order            ServiceOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  responsavel      User?              @relation("KanbanTaskResponsavel", fields: [responsavelId], references: [id])
  arquivadoPor     User?              @relation("KanbanTaskArquivador", fields: [arquivadoPorId], references: [id])
  tags             KanbanTaskTag[]
  timeEntries      TimeEntry[]
  stageTimes       KanbanStageTime[]
  alerts           TaskAlert[]

  @@index([boardId])
  @@index([columnId])
  @@index([responsavelId])
  @@index([prioridade])
  @@index([ticketId])
  @@index([orderId])
  @@index([departamentoId])
  @@index([arquivado])
  @@index([statusPrazo])
}

model KanbanSubtask {
  id            String     @id @default(uuid())
  taskId        String
  titulo        String
  concluida     Boolean    @default(false)
  ordem         Int        @default(0)
  responsavelId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now())
  responsavel   User?      @relation("KanbanSubtaskResponsavel", fields: [responsavelId], references: [id])
  task          KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model KanbanTag {
  id        String          @id @default(uuid())
  nome      String
  cor       String          @default("#6366f1")
  boardId   String?
  createdAt DateTime        @default(now())
  board     KanbanBoard?    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     KanbanTaskTag[]

  @@unique([nome, boardId])
}

model KanbanTaskTag {
  id     String     @id @default(uuid())
  taskId String
  tagId  String
  tag    KanbanTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  task   KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId])
}

model KanbanActivity {
  id             String     @id @default(uuid())
  taskId         String
  usuarioId      String?
  tipo           String
  descricao      String
  deColuna       String?
  paraColuna     String?
  dados          String?
  valorAnterior  String?
  valorNovo      String?
  origem         String? // manual | sistema | whatsapp | ia | mobile
  motivo         String?
  metadata       String?
  visivelCliente Boolean    @default(false)
  createdAt      DateTime   @default(now())
  task           KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  usuario        User?      @relation("KanbanActivityUsuario", fields: [usuarioId], references: [id])

  @@index([taskId])
  @@index([usuarioId])
  @@index([tipo])
}

model KanbanAttachment {
  id          String     @id @default(uuid())
  taskId      String
  nomeArquivo String
  url         String
  tipoMime    String?
  tamanho     Int?
  privado     Boolean    @default(true)
  usuarioId   String?
  createdAt   DateTime   @default(now())
  task        KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  usuario     User?      @relation("KanbanAttachmentUsuario", fields: [usuarioId], references: [id])

  @@index([taskId])
}

model KanbanTemplate {
  id         String   @id @default(uuid())
  nome       String
  descricao  String?
  categoria  String?
  icone      String?
  colunas    String
  tagsPadrao String?
  publico    Boolean  @default(false)
  criadorId  String?
  createdAt  DateTime @default(now())
  criador    User?    @relation("KanbanTemplateCriador", fields: [criadorId], references: [id])
}

model AlertRecipient {
  id        String   @id @default(uuid())
  nome      String
  whatsapp  String
  cargo     String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AlertHistory {
  id            String   @id @default(uuid())
  tipo          String   @default("semanal")
  destinatarios String?
  conteudo      String?
  status        String   @default("enviado")
  enviadoEm     DateTime @default(now())
  erro          String?
  createdAt     DateTime @default(now())
}

model Robot {
  id           String      @id @default(uuid())
  slug         String      @unique
  nome         String
  descricao    String
  icone        String      @default("bot")
  ativo        Boolean     @default(true)
  inteligente  Boolean     @default(false)
  ordem        Int         @default(0)
  horarioAtivo Boolean     @default(false)
  diasSemana   String      @default("1,2,3,4,5")
  horaInicio   String      @default("08:00")
  horaFim      String      @default("18:00")
  fusoHorario  String      @default("America/Fortaleza")
  config       String      @default("{}")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now())
  rules        RobotRule[]
}

model RobotRule {
  id            String   @id @default(uuid())
  robotId       String
  nome          String
  descricao     String?
  ativo         Boolean  @default(true)
  ordem         Int      @default(0)
  trigger       String   @default("{\"type\":\"new_ticket\"}")
  conditions    String   @default("[]")
  actions       String   @default("[]")
  logicOperator String   @default("all")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  robot         Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)

  @@index([robotId])
}

model AuditLog {
  id            String   @id @default(uuid())
  usuarioId     String?
  acao          String
  entidade      String
  entidadeId    String?
  detalhes      String?
  modulo        String?
  valorAnterior String?
  novoValor     String?
  userAgent     String?
  origem        String?
  resultado     String?
  metadata      String?
  ip            String?
  severity      String?  @default("baixa")
  clienteId     String?
  success       Boolean?
  errorMessage  String?
  requestId     String?
  fonte         String?  @default("manual")
  entidadeRelacionada   String?
  entidadeRelacionadaId String?
  createdAt     DateTime @default(now())
  usuario       User?    @relation(fields: [usuarioId], references: [id])
  cliente       Client?  @relation(fields: [clienteId], references: [id])

  @@index([usuarioId])
  @@index([entidade])
  @@index([createdAt])
  @@index([modulo])
  @@index([entidadeId])
  @@index([severity])
  @@index([clienteId])
  @@index([success])
  @@index([acao, createdAt])
  @@index([modulo, createdAt])
}

model AuditAlert {
  id            String   @id @default(uuid())
  tipo          String
  titulo        String
  descricao     String
  severidade    String   @default("media")
  modulo        String?
  usuarioId     String?
  clienteId     String?
  entidade      String?
  entidadeId    String?
  metadata      String?
  status        String   @default("pendente")
  analisadoPor  String?
  analisadoEm   DateTime?
  justificativa String?
  arquivadoEm   DateTime?
  createdAt     DateTime @default(now())

  @@index([tipo])
  @@index([severidade])
  @@index([status])
  @@index([createdAt])
  @@index([usuarioId])
}

model SyncLog {
  id         String   @id @default(uuid())
  origem     String
  status     String
  registros  Int?
  erro       String?
  executedAt DateTime @default(now())
}

model WhatsAppSession {
  id        String   @id @default(uuid())
  session   String
  connected Boolean  @default(false)
  qrCode    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model HelpdeskConfig {
  id                          String   @id @default(uuid())
  slug                        String   @unique
  nome                        String
  descricao                   String?
  cor                         String   @default("#3b82f6")
  icone                       String   @default("inbox")
  ordem                       Int      @default(0)
  etapaInicial                Boolean  @default(false)
  autoMessage                 String?
  enviarAuto                  Boolean  @default(false)
  notificarEquipe             Boolean  @default(false)
  tempoInatividadeMin         Int?
  mensagemTriagem             String?
  mensagemEmAtendimento       String?
  mensagemAguardandoCliente   String?
  mensagemAguardandoOs        String?
  mensagemConcluido           String?
  mensagemFollowup            String?
  mensagemBoasVindas          String?
  mensagemAckSuporte          String?
  mensagemAckComercial        String?
  mensagemOpcaoInvalida       String?
  mensagemForaHorario         String?
  mensagemCsat                String?
  horarioInicio               String?
  horarioFim                  String?
  horarioSabadoInicio         String?
  horarioSabadoFim            String?
  diasAtendimento             String?
  ordenacaoFila               String   @default("updatedAt_desc")
  ativo                       Boolean  @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @default(now())
  autoAtendimentoAtivo        Boolean  @default(false)
  maxInteracoesIa             Int      @default(5)
  mensagemDescricaoProblema   String?
  mensagemEmpresaDetectada    String?
  mensagemEmpresaNaoDetectada String?
  thresholdValidacoes         Int      @default(3)
}

model Enquete {
  id         String   @id @default(uuid())
  nome       String
  descricao  String?
  tipo       String   @default("lista") // "lista" ou "enquete"
  mensagem   String? // Mensagem de apresentação
  opcoes     Json // Array de opções [{id, titulo, descricao}]
  enviarComo String   @default("texto") // "lista" ou "texto"
  ativo      Boolean  @default(true)
  usoCount   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  @@index([ativo])
}

model HelpdeskRule {
  id            String   @id @default(uuid())
  nome          String
  categoria     String
  prioridade    Int      @default(100)
  palavrasChave String
  ativo         Boolean  @default(true)
  ordem         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@index([categoria])
  @@index([ativo])
}

model TicketStageEvent {
  id                 String   @id @default(uuid())
  ticketId           String
  etapaAnterior      String?
  etapaNova          String
  origem             String   @default("manual")
  usuarioId          String?
  mensagemAutomatica String?
  mensagemEnviada    Boolean  @default(false)
  createdAt          DateTime @default(now())
  ticket             Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuario            User?    @relation(fields: [usuarioId], references: [id])

  @@index([ticketId])
  @@index([createdAt])
}

model TicketHistory {
  id             String   @id @default(uuid())
  ticketId       String
  etapa          String
  snapshotJson   String
  totalMensagens Int      @default(0)
  geradoPor      String   @default("sistema")
  createdAt      DateTime @default(now())
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

/// Fila de atendimento (escalonamento multinivel: N1, N2, N3)
model Fila {
  id              String        @id @default(uuid())
  slug            String        @unique
  nome            String
  descricao       String?
  nivel           String        @default("N1")
  slaMinutos      Int           @default(60)
  cor             String        @default("#3b82f6")
  icone           String        @default("inbox")
  ordem           Int           @default(0)
  ativo           Boolean       @default(true)
  departamentoId  String?
  nivelSuporteId  String?
  proximaFilaId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now())
  departamento    Departamento? @relation(fields: [departamentoId], references: [id])
  nivelSuporte    NivelSuporte? @relation(fields: [nivelSuporteId], references: [id])
  proximaFila     Fila?         @relation("EscalacaoFila", fields: [proximaFilaId], references: [id])
  filasAnteriores Fila[]        @relation("EscalacaoFila")
  tickets         Ticket[]
  assuntos        Assunto[]     @relation("AssuntoFila")
}

/// Departamento / Setor da empresa
model Departamento {
  id                  String                 @id @default(uuid())
  slug                String                 @unique
  nome                String
  descricao           String?
  cor                 String                 @default("#3b82f6")
  icone               String                 @default("building")
  ordem               Int                    @default(0)
  slaMinutos          Int                    @default(240)
  ativo               Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @default(now())
  channels            Channel[]
  filas               Fila[]
  tickets             Ticket[]
  usuarios            UserDepartamento[]
  whatsappConnections WhatsAppConnection[]
  departmentTimes     TicketDepartmentTime[]
  timeEntries         TimeEntry[]
  teams               Team[]
  kanbanTasks         KanbanTask[]
  categorias          Categoria[]            @relation("CategoriaDepartamento")
  assuntos            Assunto[]              @relation("AssuntoDepartamento")
}

/// Nivel de suporte (customizavel: N1, N2, N3, N4, Supervisor, etc.)
model NivelSuporte {
  id         String   @id @default(uuid())
  slug       String   @unique
  nome       String
  descricao  String?
  cor        String   @default("#3b82f6")
  icone      String   @default("layers")
  ordem      Int      @default(0)
  slaMinutos Int?
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  filas      Fila[]
  tickets    Ticket[]
}

/// Conexao WhatsApp (multi-numero)
model WhatsAppConnection {
  id             String        @id @default(uuid())
  nome           String
  numero         String
  slug           String        @unique
  departamentoId String?
  ativo          Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())
  provider       String        @default("baileys")
  tickets        Ticket[]
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])
}

/// Canal de atendimento unificado (WhatsApp, Email, Instagram, Facebook, Telegram, etc.)
model Channel {
  id              String           @id @default(uuid())
  nome            String
  tipo            String
  slug            String           @unique
  provider        String?
  config          String?
  departamentoId  String?
  ativo           Boolean          @default(true)
  avatar          String?
  cor             String?
  metadata        String?
  lastSyncAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  departamento    Departamento?    @relation(fields: [departamentoId], references: [id])
  channelMessages ChannelMessage[]
  riskLogs        ChannelRiskLog[]
  tickets         Ticket[]
}

/// Mensagens unificadas de qualquer canal
model ChannelMessage {
  id          String   @id @default(uuid())
  channelId   String
  externalId  String?
  ticketId    String?
  fromMe      Boolean  @default(false)
  contactName String?
  contactId   String?
  content     String?
  mediaUrl    String?
  mimeType    String?
  status      String?  @default("received")
  rawPayload  String?
  createdAt   DateTime @default(now())
  channel     Channel  @relation(fields: [channelId], references: [id])
  ticket      Ticket?  @relation(fields: [ticketId], references: [id])

  @@index([channelId])
  @@index([ticketId])
  @@index([externalId])
  @@index([createdAt])
}

/// Log de riscos e estabilidade por canal
model ChannelRiskLog {
  id          String    @id @default(uuid())
  channelId   String
  tipo        String
  severidade  String    @default("info")
  mensagem    String
  resolvido   Boolean   @default(false)
  resolvidoEm DateTime?
  createdAt   DateTime  @default(now())
  channel     Channel   @relation(fields: [channelId], references: [id])

  @@index([channelId])
  @@index([tipo])
}

/// Integracao externa (ex: CRM) — configuracao da camada de integracao.
/// Campos sensiveis (apiKey/token) sao criptografados em repouso (AES-256-GCM)
/// e nunca retornados por completo nas respostas da API.
model ExternalIntegration {
  id              String    @id @default(uuid())
  nome            String
  slug            String    @unique
  tipo            String    @default("crm")
  baseUrl         String
  authType        String    @default("api_key") // api_key | bearer_token | oauth2
  apiKeyEnc       String?
  tokenEnc        String?
  headersJson     String    @default("{}")
  timeoutMs       Int       @default(15000)
  ativo           Boolean   @default(true)
  webhookPath     String?
  webhookSecret   String?
  lastTestAt      DateTime?
  lastTestStatus  String?
  lastTestError   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  logs            ExternalIntegrationLog[]
}

/// Log de auditoria das chamadas de integracao (inbound/outbound)
model ExternalIntegrationLog {
  id            String    @id @default(uuid())
  integrationId String?
  direction     String    @default("outbound") // outbound | inbound
  endpoint      String?
  method        String?
  status        Int?
  requestBody   String?
  responseBody  String?
  error         String?
  durationMs    Int?
  createdAt     DateTime  @default(now())
  integration   ExternalIntegration? @relation(fields: [integrationId], references: [id])

  @@index([integrationId])
  @@index([createdAt])
}

/// Configuracao de SLA por prioridade
model SLAConfig {
  id                         String   @id @default(uuid())
  prioridade                 String   @unique
  slaMinutosPrimeiraResposta Int      @default(60)
  slaMinutosResolucao        Int      @default(240)
  alerta75Porcento           Boolean  @default(true)
  alerta90Porcento           Boolean  @default(true)
  ativo                      Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @default(now())
}

/// Categoria de ticket (formalizacao das categorias existentes)
model Categoria {
  id             String        @id @default(uuid())
  slug           String        @unique
  nome           String
  descricao      String?
  cor            String        @default("#3b82f6")
  icone          String        @default("tag")
  ordem          Int           @default(0)
  ativo          Boolean       @default(true)
  departamentoId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())
  departamento   Departamento? @relation("CategoriaDepartamento", fields: [departamentoId], references: [id])
  articles       KBArticle[]
  tickets        Ticket[]
  assuntos       Assunto[]
}

/// Assunto de ticket (hierarquia Categoria -> Assunto)
model Assunto {
  id               String        @id @default(uuid())
  slug             String        @unique
  nome             String
  descricao        String?
  categoriaId      String
  icone            String        @default("tag")
  cor              String        @default("#3b82f6")
  prioridadePadrao String        @default("media")
  slaPadraoMin     Int?
  departamentoId   String?
  idFila           String?
  ordem            Int           @default(0)
  ativo            Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now())
  categoria        Categoria     @relation(fields: [categoriaId], references: [id])
  departamento     Departamento? @relation("AssuntoDepartamento", fields: [departamentoId], references: [id])
  fila             Fila?         @relation("AssuntoFila", fields: [idFila], references: [id])
  tickets          Ticket[]

  @@index([categoriaId])
  @@index([departamentoId])
  @@index([idFila])
  @@index([ativo])
}

/// Ativo (asset) - software/hardware/servico/sistema vinculado a um cliente
model Ativo {
  id        String   @id @default(uuid())
  nome      String
  tipo      String
  descricao String?
  serial    String?
  clienteId String?
  metadata  String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  cliente   Client?  @relation(fields: [clienteId], references: [id])
  tickets   Ticket[]
}

/// Artigo da Base de Conhecimento
model KBArticle {
  id            String             @id @default(uuid())
  slug          String             @unique
  titulo        String
  conteudo      String
  resumo        String?
  categoriaId   String?
  tags          String             @default("")
  autorId       String?
  passos        String?
  imagens       String?
  versaoAtual   Int                @default(1)
  visualizacoes Int                @default(0)
  util          Int                @default(0)
  inutil        Int                @default(0)
  publicado     Boolean            @default(false)
  ordem         Int                @default(0)
  ativo         Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now())
  autor         User?              @relation("KBArticleAutor", fields: [autorId], references: [id])
  categoria     Categoria?         @relation(fields: [categoriaId], references: [id])
  versoes       KBArticleVersion[]

  @@index([categoriaId])
  @@index([autorId])
  @@index([publicado])
}

/// Historico de versoes do artigo KB
model KBArticleVersion {
  id        String    @id @default(uuid())
  articleId String
  versao    Int
  titulo    String
  conteudo  String
  resumo    String?
  passos    String?
  imagens   String?
  autorId   String?
  createdAt DateTime  @default(now())
  article   KBArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  autor     User?     @relation("KBArticleVersionAutor", fields: [autorId], references: [id])

  @@unique([articleId, versao])
}

/// Resposta CSAT (pesquisa de satisfacao)
model CSATResposta {
  id            String    @id @default(uuid())
  ticketId      String    @unique
  nota          Int?
  comentario    String?
  tokenResposta String    @unique @default(uuid())
  enviadoEm     DateTime?
  respondidoEm  DateTime?
  createdAt     DateTime  @default(now())
  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([respondidoEm])
  @@index([nota])
}

/// Notificacao interna para usuario
model Notificacao {
  id             String   @id @default(uuid())
  tipo           String
  mensagem       String
  destinatarioId String
  ticketId       String?
  dados          String?
  lida           Boolean  @default(false)
  createdAt      DateTime @default(now())
  destinatario   User     @relation(fields: [destinatarioId], references: [id])
  ticket         Ticket?  @relation(fields: [ticketId], references: [id])

  @@index([destinatarioId])
  @@index([ticketId])
  @@index([lida])
}

/// Fluxo de autorização formal para ações que exigem aprovação
model Aprovacao {
  id                String    @id @default(uuid())
  ticketId          String
  solicitadoPorId   String
  aprovadoPorId     String?
  tipo              String    @default("geral")
  motivo            String
  observacao        String?
  status            String    @default("pendente")
  valorAprovado     Float?
  canal             String    @default("interno")
  telefoneAprovador String?
  token             String?   @unique
  expiraEm          DateTime?
  dataSolicitacao   DateTime  @default(now())
  dataDecisao       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now())
  aprovadoPor       User?     @relation("AprovacaoAprovador", fields: [aprovadoPorId], references: [id])
  solicitadoPor     User      @relation("AprovacaoSolicitante", fields: [solicitadoPorId], references: [id])
  ticket            Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

/// Regra de automacao WHEN/IF/THEN
model AutomationRule {
  id            String   @id @default(uuid())
  nome          String
  descricao     String?
  trigger       String
  condicoes     String   @default("[]")
  acoes         String   @default("[]")
  logicOperator String   @default("all")
  ativo         Boolean  @default(true)
  ordem         Int      @default(0)
  autorId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
}

/// Permissao por role (override da matriz padrao)
/// Se `granted` e true, libera; se e false, nega; se nao existe registro, usa default do codigo.
model RolePermission {
  id        String   @id @default(uuid())
  role      String
  resource  String
  action    String
  granted   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([role, resource, action])
  @@index([role])
}

/// Feriado nacional/estadual/municipal para bloqueio do horario comercial
/// data: se recorrente=true, considera apenas mes/dia; senao considera data completa
model Feriado {
  id         String   @id @default(uuid())
  data       DateTime
  nome       String
  tipo       String   @default("nacional")
  recorrente Boolean  @default(false)
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  @@index([data])
}

/// Tabela pivô: Usuario pode pertencer a multiplos departamentos
model UserDepartamento {
  id             String       @id @default(uuid())
  userId         String
  departamentoId String
  createdAt      DateTime     @default(now())
  departamento   Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, departamentoId])
  @@index([departamentoId])
}

/// Configuracao de cobranca do cliente (terminais, hostlinks, interfaces, exames)
model ClientBilling {
  id            String           @id @default(uuid())
  clientId      String
  tipo          String
  quantidade    Int              @default(0)
  valorUnitario Float            @default(0)
  ativo         Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now())
  historico     BillingHistory[]
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, tipo])
  @@index([clientId])
  @@index([tipo])
}

/// Historico de alteracoes de quantidade (audit trail)
model BillingHistory {
  id                 String        @id @default(uuid())
  billingId          String
  clienteId          String
  tipo               String
  quantidadeAnterior Int
  quantidadeNova     Int
  valorUnitario      Float
  usuarioId          String?
  motivo             String?
  createdAt          DateTime      @default(now())
  billing            ClientBilling @relation(fields: [billingId], references: [id], onDelete: Cascade)
  client             Client        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuario            User?         @relation(fields: [usuarioId], references: [id])

  @@index([billingId])
  @@index([clienteId])
  @@index([createdAt])
}

/// Pendencia de cobranca mensal
model BillingPendency {
  id           String    @id @default(uuid())
  clienteId    String
  tipo         String
  periodo      String
  quantidade   Int
  valorTotal   Float
  status       String    @default("pendente")
  notificadoEm DateTime?
  resolvidoEm  DateTime?
  resolvidoPor String?
  observacao   String?
  createdAt    DateTime  @default(now())
  client       Client    @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, tipo, periodo])
  @@index([clienteId])
  @@index([status])
  @@index([periodo])
}

/// Evento atomico do ticket (criacao, mensagem, atribuicao, movimentacao, SLA, IA, etc.)
/// Cada linha e imutavel — audit trail completo do lifetime do ticket.
model TicketEvent {
  id         String   @id @default(uuid())
  ticketId   String
  tipo       String
  descricao  String?
  dados      String?
  usuarioId  String?
  isSystem   Boolean  @default(false)
  isAi       Boolean  @default(false)
  mensagemId String?
  metadata   String?
  createdAt  DateTime @default(now())
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuario    User?    @relation(fields: [usuarioId], references: [id])

  @@index([ticketId])
  @@index([tipo])
  @@index([createdAt])
  @@index([usuarioId])
  @@index([ticketId, tipo])
}

/// Timeline horizontal do ticket — eventos pre-calculados com delta times entre etapas.
/// Atualizado a cada movimentacao para evitar calculos em runtime.
model TicketTimeline {
  id                    String    @id @default(uuid())
  ticketId              String
  etapa                 String
  dataEntrada           DateTime
  dataSaida             DateTime?
  duracaoMinutos        Int?
  duracaoBusinessMin    Int?
  responsavelAnteriorId String?
  responsavelNovoId     String?
  motivoMudanca         String?
  isPaused              Boolean   @default(false)
  pausaTotalMinutos     Int       @default(0)
  createdAt             DateTime  @default(now())
  responsavelAnterior   User?     @relation("TimelineResponsavelAnterior", fields: [responsavelAnteriorId], references: [id])
  responsavelNovo       User?     @relation("TimelineResponsavelNovo", fields: [responsavelNovoId], references: [id])
  ticket                Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([etapa])
  @@index([dataEntrada])
  @@index([ticketId, dataEntrada])
}

/// Metricas consolidadas do ticket — 15 tempos calculados e cacheados.
/// Atualizado quando o ticket e movimentado ou fechado.
model TicketMetrics {
  id                          String    @id @default(uuid())
  ticketId                    String    @unique
  tempoTotalMin               Int       @default(0)
  tempoPrimeiraRespostaMin    Int?
  tempoPrimeiraRespostaIaMin  Int?
  tempoPrimeiraRespostaHumMin Int?
  tempoEmAtendimentoMin       Int       @default(0)
  tempoAguardandoClienteMin   Int       @default(0)
  tempoAguardandoTerceiroMin  Int       @default(0)
  tempoFilaMin                Int       @default(0)
  tempoResolucaoIaMin         Int?
  tempoResolucaoHumanoMin     Int?
  tempoLeadTimeMin            Int       @default(0)
  tempoUtilMin                Int       @default(0)
  tempoCorridoMin             Int       @default(0)
  tempoForaExpedienteMin      Int       @default(0)
  tempoParadoMin              Int       @default(0)
  totalMensagens              Int       @default(0)
  mensagensCliente            Int       @default(0)
  mensagensAgente             Int       @default(0)
  mensagensBot                Int       @default(0)
  totalReaberturas            Int       @default(0)
  totalEscalonamentos         Int       @default(0)
  slaPrazoMinutos             Int?
  slaConsumidoMinutos         Int       @default(0)
  slaRestanteMinutos          Int       @default(0)
  slaPercentualConsumido      Float     @default(0)
  slaStatus                   String?
  csatNota                    Int?
  csatRespondido              Boolean   @default(false)
  resolvidoPorIa              Boolean   @default(false)
  iaConfiancaMedia            Float?
  iaTotalInteracoes           Int       @default(0)
  iaCustoTotalUsd             Float     @default(0)
  iaCustoTotalBrl             Float     @default(0)
  primeiraRespostaEm          DateTime?
  ultimoAtendimentoEm         DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @default(now())
  ticket                      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([slaStatus])
  @@index([resolvidoPorIa])
}

/// Log de lifecycle do SLA — cada transicao de estado e registrada.
model TicketSlaLog {
  id           String   @id @default(uuid())
  ticketId     String
  acao         String
  slaMinutos   Int
  percentual   Float?
  restantesMin Int?
  motivo       String?
  dados        String?
  usuarioId    String?
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuario      User?    @relation(fields: [usuarioId], references: [id])

  @@index([ticketId])
  @@index([acao])
  @@index([createdAt])
}

/// Atividade de usuario no ticket — visualizacoes, edicoes, notas internas.
model TicketActivity {
  id        String   @id @default(uuid())
  ticketId  String
  usuarioId String?
  tipo      String
  descricao String?
  dados     String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuario   User?    @relation(fields: [usuarioId], references: [id])

  @@index([ticketId])
  @@index([usuarioId])
  @@index([tipo])
  @@index([createdAt])
}

/// Tempo de espera do ticket em cada etapa — registro granular.
model TicketWaitTime {
  id          String    @id @default(uuid())
  ticketId    String
  etapa       String
  dataEntrada DateTime
  dataSaida   DateTime?
  duracaoMin  Int?
  motivo      String?
  usuarioId   String?
  createdAt   DateTime  @default(now())
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuario     User?     @relation(fields: [usuarioId], references: [id])

  @@index([ticketId])
  @@index([etapa])
  @@index([dataEntrada])
  @@index([ticketId, etapa])
}

/// Log de processamento de IA no ticket — cada interacao com a IA e registrada.
model TicketAiLog {
  id                     String   @id @default(uuid())
  ticketId               String
  tipo                   String
  modelo                 String?
  inputTokens            Int?
  outputTokens           Int?
  custoUsd               Float?
  custoBrl               Float?
  latenciaMs             Int?
  confianca              Float?
  resultado              String?
  correcaoId             String?
  erro                   String?
  duracaoProcessamentoMs Int?
  createdAt              DateTime @default(now())
  ticket                 Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([tipo])
  @@index([modelo])
  @@index([createdAt])
}

/// Performance consolidada por agente/equipe — metricas agregadas por periodo.
model TicketPerformance {
  id                      String   @id @default(uuid())
  periodo                 String
  tipoPeriodo             String   @default("mensal")
  usuarioId               String?
  departamentoId          String?
  ticketsRecebidos        Int      @default(0)
  ticketsResolvidos       Int      @default(0)
  ticketsEscalonados      Int      @default(0)
  ticketsReabertos        Int      @default(0)
  ticketsCancelados       Int      @default(0)
  mttrMin                 Float    @default(0)
  mttaMin                 Float    @default(0)
  mtfaMin                 Float    @default(0)
  mtFilaMin               Float    @default(0)
  slaCompliancePct        Float    @default(0)
  slaViolados             Int      @default(0)
  slaNoPrazo              Int      @default(0)
  csatMedio               Float?
  csatTotalRespostas      Int      @default(0)
  fcrPct                  Float    @default(0)
  iaResolveu              Int      @default(0)
  iaConfiancaMedia        Float?
  iaCustoTotalUsd         Float    @default(0)
  totalMensagensEnviadas  Int      @default(0)
  totalMensagensRecebidas Int      @default(0)
  tempoAtivoMinutos       Float    @default(0)
  createdAt               DateTime @default(now())
  usuario                 User?    @relation(fields: [usuarioId], references: [id])

  @@unique([periodo, tipoPeriodo, usuarioId, departamentoId])
  @@index([periodo])
  @@index([usuarioId])
  @@index([departamentoId])
}

/// Respostas propostas pela IA aguardando validação de atendentes humanos
model AIRespostaValidacao {
  id               String    @id @default(uuid())
  ticketId         String
  mensagemCliente  String
  respostaProposta String
  assunto          String?
  prioridade       String?
  confianca        Float?
  status           String    @default("pendente")
  validacoesCount  Int       @default(0)
  validacaoIds     String[]
  respostaFinal    String?
  enviadaEm        DateTime?
  criadaPorIaEm    DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  ticket           Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([status])
  @@index([createdAt])
}

/// ── Time Tracking: registro de horas por atividade ───────────────────
model TimeEntry {
  id              String           @id @default(uuid())
  usuarioId       String
  ticketId        String?
  orderId         String?
  projectId       String?
  clienteId       String?
  tarefaId        String?
  setorId         String?
  tipo            String           @default("suporte")
  descricao       String?
  dataInicio      DateTime         @default(now())
  dataFim         DateTime?
  duracaoMin      Int?
  billable        Boolean          @default(true)
  faturado        Boolean          @default(false)
  tags            String[]
  pausado         Boolean          @default(false)
  pausadoEm       DateTime?
  pausadoTotalMin Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  order           ServiceOrder?    @relation(fields: [orderId], references: [id])
  ticket          Ticket?          @relation(fields: [ticketId], references: [id])
  cliente         Client?          @relation(fields: [clienteId], references: [id])
  tarefa          KanbanTask?      @relation(fields: [tarefaId], references: [id])
  setor           Departamento?    @relation(fields: [setorId], references: [id])
  usuario         User             @relation(fields: [usuarioId], references: [id])
  blocos          TimeEntryBlock[]

  @@index([usuarioId])
  @@index([ticketId])
  @@index([orderId])
  @@index([clienteId])
  @@index([tarefaId])
  @@index([setorId])
  @@index([tipo])
  @@index([dataInicio])
  @@index([billable])
}

/// Blocos de uma sessao de tempo (inicio/pausa/retomada/fim) para auditoria de horario.
model TimeEntryBlock {
  id          String    @id @default(uuid())
  timeEntryId String
  tipo        String // inicio | pausa | retomada | fim
  data        DateTime  @default(now())
  usuarioId   String?
  observacao  String?
  createdAt   DateTime  @default(now())
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  usuario     User?     @relation(fields: [usuarioId], references: [id])

  @@index([timeEntryId])
  @@index([tipo])
  @@index([data])
}

/// Tempo que a tarefa permaneceu em cada coluna/etapa (para analises posteriores).
model KanbanStageTime {
  id          String        @id @default(uuid())
  taskId      String
  columnId    String?
  columnNome  String
  dataEntrada DateTime      @default(now())
  dataSaida   DateTime?
  duracaoMin  Int?
  usuarioId   String?
  createdAt   DateTime      @default(now())
  task        KanbanTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  column      KanbanColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)
  usuario     User?         @relation(fields: [usuarioId], references: [id])

  @@index([taskId])
  @@index([columnId])
  @@index([dataEntrada])
}

/// Equipe de trabalho (agrupamento opcional alem do departamento).
model Team {
  id             String        @id @default(uuid())
  nome           String        @unique
  descricao      String?
  departamentoId String?
  liderId        String?
  ativo          Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])
  lider          User?         @relation("TeamLider", fields: [liderId], references: [id])
  membros        TeamMember[]
  kanbanTasks    KanbanTask[]

  @@index([departamentoId])
  @@index([ativo])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
}

/// Alertas automaticos sobre tarefas (prazo proximo/atrasado, sem movimentacao, etc).
model TaskAlert {
  id        String     @id @default(uuid())
  taskId    String
  tipo      String // proxima_prazo | atrasada | sem_movimentacao | reaberta | excesso_tarefas | prazo_alterado | divergencia_prazo
  mensagem  String
  lida      Boolean    @default(false)
  createdAt DateTime   @default(now())
  task      KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([tipo])
  @@index([lida])
  @@index([createdAt])
}

/// Checklist dentro de um ticket (tarefas a serem cumpridas)
model TicketChecklist {
  id            String   @id @default(uuid())
  ticketId      String
  titulo        String
  concluida     Boolean  @default(false)
  ordem         Int      @default(0)
  responsavelId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  responsavel   User?    @relation(fields: [responsavelId], references: [id])

  @@index([ticketId])
  @@index([concluida])
}

/// Template de checklist reutilizável (pode ser usado em tickets e kanban)
model ChecklistTemplate {
  id        String   @id @default(uuid())
  nome      String
  descricao String?
  categoria String?  @default("geral")
  items     String   @default("[]") // JSON array of { titulo: string, ordem: number }
  publico   Boolean  @default(false)
  criadorId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  criador   User?    @relation(fields: [criadorId], references: [id])

  @@index([criadorId])
  @@index([categoria])
}

/// Tempo gasto por departamento/setor em um ticket
model TicketDepartmentTime {
  id             String       @id @default(uuid())
  ticketId       String
  departamentoId String
  userId         String?
  dataInicio     DateTime     @default(now())
  dataFim        DateTime?
  duracaoMin     Int?
  kanbanTaskId   String?
  createdAt      DateTime     @default(now())
  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  departamento   Departamento @relation(fields: [departamentoId], references: [id])
  user           User?        @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([departamentoId])
  @@index([ticketId, departamentoId])
}

/// Registro de interação de agentes no ticket (para FCR)
model TicketAgentInteraction {
  id        String   @id @default(uuid())
  ticketId  String
  usuarioId String
  tipo      String   @default("mensagem")
  conteudo  String?
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuario   User     @relation(fields: [usuarioId], references: [id])

  @@index([ticketId])
  @@index([usuarioId])
  @@index([ticketId, usuarioId])
}

/// Contato ou grupo excluído do fluxo automático do Helpdesk.
/// A mensagem continua chegando no WhatsApp, mas NÃO inicia atendimento.
model ContatoIgnorado {
  id             String    @id @default(uuid())
  tipo           String    @default("contato") // contato | grupo
  chave          String    @unique // telefone normalizado (contato) ou jid (grupo)
  nome           String
  motivo         String?
  regra          String    @default("ignorar_helpdesk") // ignorar_helpdesk | bloquear
  ignorado       Boolean   @default(true) // true = ignorado (regra ativa); false = reativado
  criadoPorId    String?
  reativadoPorId String?
  criadoEm       DateTime  @default(now())
  reativadoEm    DateTime?
  historico      String? // JSON: [{data, usuario, acao, motivo}]
  criadoPor      User?     @relation("ContatoIgnoradoCriadoPor", fields: [criadoPorId], references: [id])
  reativadoPor   User?     @relation("ContatoIgnoradoReativadoPor", fields: [reativadoPorId], references: [id])

  @@index([tipo])
  @@index([ignorado])
  @@index([criadoEm])
}
