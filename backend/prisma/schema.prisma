  @@index([processadoEm])
}

/// Detecção de encerramento (prematuro / resolução real / reabertura) por ticket,
/// persistida automaticamente no fechamento e agregada por agente no monitor.
model AIAgentClosureAudit {
  id                        String    @id @default(uuid())
  ticketId                  String    @unique
  protocolo                 String?
