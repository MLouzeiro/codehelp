  tags             KanbanTaskTag[]
  alerts           TaskAlert[]
  timeEntries      TimeEntry[]

  @@index([boardId])
  @@index([columnId])
  @@index([responsavelId])
  @@index([prioridade])
  @@index([ticketId])
  @@index([orderId])
  @@index([departamentoId])
  @@index([arquivado])
  @@index([statusPrazo])
}

