  notaGeral                 Float     @default(0)
  classificacao             String    @default("ATENCAO")
  classificacaoResolucao    String    @default("SEM_CONFIRMACAO")
  classificacaoEncerramento String    @default("SEM_ENCERRAMENTO")
  padrao                    String    @default("EVENTO_ISOLADO")
  confiancaMedia            Float     @default(0)
  analiseInconclusiva       Boolean   @default(false)
  resumoExecutivo           String?
  analiseQualitativa        String?
  explicacaoLeiga           String?
  evidenciaProblemas        String?
  pontosFortes              String?
  riscos                    String?
  recomendacoes             String?
  planoMelhoria             String?
