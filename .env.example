# ============================================
# CODEMED HUB — Variaveis de Ambiente
# Copie este arquivo para .env e preencha
# ============================================

# --- Banco de Dados (PostgreSQL) ---
DATABASE_URL=postgresql://codemed:codemed123@localhost:5432/codemed_hub

# --- Redis (opcional, para cache) ---
REDIS_URL=redis://localhost:6379

# --- Seguranca (MUDE EM PRODUCAO!) ---
JWT_SECRET=coloque_um_secret_forte_aqui_32chars
JWT_REFRESH_SECRET=coloque_outro_secret_forte_aqui_32chars

# --- URLs da Aplicacao ---
APP_URL=http://localhost:3000
API_URL=http://localhost:3010
PORT=3010

# --- Ambiente ---
NODE_ENV=development
TIMEZONE=America/Fortaleza

# --- WhatsApp (Opcional) ---
WHATSAPP_SESSION_PATH=./whatsapp-session
WHATSAPP_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# --- Email SMTP (Opcional, para alertas) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Alertas ---
ALERT_WHATSAPP_NUMBERS=
ALERT_DAY=1
ALERT_HOUR=8

# --- IA (Opcional) ---
ANTHROPIC_API_KEY=
