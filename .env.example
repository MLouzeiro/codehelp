# ============================
# Codemed Hub - Environment
# ============================

# Database
DATABASE_URL=postgresql://codemed:codemed123@localhost:5432/codemed_hub
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production

# App
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NODE_ENV=development

# WhatsApp (Native - whatsapp-web.js)
WHATSAPP_SESSION_PATH=./whatsapp-session

# Anthropic (IA Insights) - Optional
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Email (SMTP) - Optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Weekly Alert Configuration
ALERT_WHATSAPP_NUMBERS=
ALERT_DAY=1
ALERT_HOUR=8
TIMEZONE=America/Fortaleza
