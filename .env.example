# =============================================================================
# .env.example — CodeHelp Backend
# Copie este arquivo para .env e preencha os valores
# NUNCA versione o arquivo .env com valores reais
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO DE DADOS (OBRIGATORIO)
# -----------------------------------------------------------------------------
# PostgreSQL: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=

# -----------------------------------------------------------------------------
# AUTENTICACAO (OBRIGATORIO em producao)
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=

# -----------------------------------------------------------------------------
# AMBIENTE
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3010

# -----------------------------------------------------------------------------
# URLs (OBRIGATORIO em producao)
# -----------------------------------------------------------------------------
# URL do frontend (ex: https://seu-app.vercel.app)
APP_URL=
# URL do backend (ex: https://codehelp-backend.fly.dev)
API_URL=
# URLs permitidas por CORS (separadas por virgula)
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# WHATSAPP (Opcional — necessario para integracao)
# -----------------------------------------------------------------------------
# Evolution API (self-hosted)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=codehelp

# WhatsApp Cloud API (Meta oficial)
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_API_VERSION=v19.0
WHATSAPP_CLOUD_WEBHOOK_VERIFY_TOKEN=

# -----------------------------------------------------------------------------
# INTELIGENCIA ARTIFICIAL (Opcional)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# EMAIL (Opcional)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# REDIS (Opcional — fallback se indisponivel)
# -----------------------------------------------------------------------------
REDIS_URL=

# -----------------------------------------------------------------------------
# SEGURANCA
# -----------------------------------------------------------------------------
# Chave para criptografia de integracoes (AES-256-GCM)
INTEGRATION_ENCRYPTION_KEY=
# API keys para acesso publico (separadas por virgula, sufixo :rw = escrita)
INTEGRATION_API_KEYS=

# -----------------------------------------------------------------------------
# WHATSAPP — SESSAO (Fly.io usa volume persistente)
# -----------------------------------------------------------------------------
WHATSAPP_SESSION_PATH=/app/whatsapp-session

# -----------------------------------------------------------------------------
# WHATSAPP — RECUPERACAO DE MENSAGENS APOS RECONEXAO
# WHATSAPP_RECOVERY_ENABLED: habilita a janela de recuperacao (default: true)
# WHATSAPP_RECOVERY_MAX_AGE_HOURS: janela maxima (horas) de mensagens offline
#   recuperadas via lote "append" (default: 168 = 7 dias)
# WHATSAPP_SYNC_FULL_HISTORY: sincroniza historico completo ao parear sessao
#   (default: false — liga apenas history sync do Baileys, use com cuidado)
# -----------------------------------------------------------------------------
WHATSAPP_RECOVERY_ENABLED=true
WHATSAPP_RECOVERY_MAX_AGE_HOURS=168
WHATSAPP_SYNC_FULL_HISTORY=false
